generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

// ============================================================
// ENUMS
// ============================================================

enum TipoPersona {
  NATURAL
  JURIDICA
  SUCESION
}

enum EstadoRegistro {
  ACTIVO
  INACTIVO
  BAJA
}

// Persona (P16): PENDIENTE = datos por validar; no frena la tributación.
enum EstadoPersona {
  HABILITADO
  INHABILITADO
  PENDIENTE
}

enum EstadoCuenta {
  PENDIENTE
  CANCELADO
  FRACCIONADO
  COACTIVO
  ANULADO
  EXTORNADO
}

enum MedioPago {
  EFECTIVO
  CHEQUE
  TARJETA
  DEPOSITO
  TRANSFERENCIA
}

enum TipoTributo {
  PREDIAL
  ARBITRIOS
  VEHICULAR
  ALCABALA
  MULTA
  TUPA
  OTRO
}

enum TipoValor {
  OP // Orden de Pago
  RD // Resolucion de Determinacion
  RM // Resolucion de Multa (Codigo Tributario art. 77)
}

enum EstadoValor {
  EMITIDO
  NOTIFICADO
  COACTIVO
  CANCELADO
  ANULADO
}

// Código Tributario art. 104
enum ModalidadNotificacion {
  PERSONAL
  NEGATIVA
  CEDULON
  PUBLICACION
}

enum EstadoTransferencia {
  ENVIADA
  RECIBIDA
  DEVUELTA
}

enum MotivoDeclaracion {
  INSCRIPCION
  COMPRA
  VENTA
  RECTIFICACION
  BAJA
  FISCALIZACION // la aplica la resolución de un expediente de fiscalización
}

enum TipoFiscalizacion {
  ORDINARIA
  A_SOLICITUD
}

enum EstadoFiscalizacion {
  ABIERTO
  INSPECCIONADO
  RESUELTO
  SIN_DIFERENCIAS
  ANULADO
}

enum BaseMulta {
  UIT // % de la UIT del año de la infracción
  TRIBUTO_OMITIDO // % del tributo omitido
}

enum ComponenteConstruccion {
  MUROS_COLUMNAS
  TECHOS
  PISOS
  PUERTAS_VENTANAS
  REVESTIMIENTOS
  BANOS
  INSTALACIONES
}

enum TipoTasaMora {
  TIM // tasa de interés moratorio mensual (%)
  IPM // índice de precios al por mayor (reajuste cuotas 2-4)
}

enum EstadoLicencia {
  VIGENTE
  VENCIDA
  ANULADA
}

enum AccionAuditoria {
  CREATE
  UPDATE
  DELETE
  LOGIN
  LOGIN_FALLIDO
  LOGOUT
}

enum TipoNivel {
  MODULO
  FUNCIONALIDAD
}

// ============================================================
// A. ADMINISTRACION Y SEGURIDAD
// Ref SIMUN: usuarios.dbf + roles.dbf + oficinas.dbf
// SIMUN es solo referencial: no se migran datos.
// creadoPorId/modificadoPorId: los llena el trigger auditoria_autor
// desde app.usuario_id (specs/auditoria-v1.md); nunca el DTO.
// ============================================================

model Oficina {
  id              Int       @id @default(autoincrement())
  codigo          String    @unique @db.VarChar(10)
  nombre          String    @db.VarChar(100)
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creadoPorId     Int?
  creadoPor       Usuario?  @relation("OficinaCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId Int?
  modificadoPor   Usuario?  @relation("OficinaModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  usuarios        Usuario[]

  @@map("oficinas")
}

model Rol {
  id              Int        @id @default(autoincrement())
  nombre          String     @unique @db.VarChar(50)
  descripcion     String?    @db.VarChar(200)
  activo          Boolean    @default(true) // baja lógica: DELETE /roles/:id desactiva
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  creadoPorId     Int?
  creadoPor       Usuario?   @relation("RolCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId Int?
  modificadoPor   Usuario?   @relation("RolModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  usuarios        Usuario[]
  accesos         RolNivel[]

  @@map("roles")
}

model Nivel {
  id             Int        @id @default(autoincrement())
  codigo         String     @unique @db.VarChar(100) // llave estable del permiso (ej. accesibilidad.usuarios)
  tipo           TipoNivel
  nombre         String     @db.VarChar(100)
  descripcion    String?    @db.VarChar(200)
  padreId        Int? // MODULO=null, FUNCIONALIDAD=modulo padre
  padre          Nivel?     @relation("NivelJerarquia", fields: [padreId], references: [id], onDelete: Restrict)
  hijos          Nivel[]    @relation("NivelJerarquia")
  rolesAsignados RolNivel[]
  orden          Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt

  @@index([padreId])
  @@map("niveles")
}

model RolNivel {
  rolId     Int
  rol       Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)
  nivelId   Int
  nivel     Nivel    @relation(fields: [nivelId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt

  @@id([rolId, nivelId])
  @@map("rol_nivel")
}

model Usuario {
  id              Int      @id @default(autoincrement())
  nombres         String   @db.VarChar(100)
  apellidos       String   @db.VarChar(100)
  usuario         String   @unique @db.VarChar(50)
  password        String   @db.VarChar(255) // hash bcrypt, nunca texto plano
  rolId           Int
  rol             Rol      @relation(fields: [rolId], references: [id], onDelete: Restrict)
  activo          Boolean  @default(true)
  oficinaId       Int?
  oficina         Oficina? @relation(fields: [oficinaId], references: [id], onDelete: SetNull)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt
  creadoPorId     Int?
  creadoPor       Usuario? @relation("UsuarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId Int?
  modificadoPor   Usuario? @relation("UsuarioModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  recibosCobrados    Recibo[]           @relation("CajeroRecibos")
  recibosExtornados  Recibo[]           @relation("ReciboExtornadoPor")
  cierresCaja        CierreCaja[]
  conveniosCreados   ConvenioCab[]      @relation("CreadorConvenio")
  auditorias         Auditoria[]
  chatConversaciones ChatConversacion[]

  // Autoría (creadoPor/modificadoPor) de las tablas principales
  usuariosCreados            Usuario[]           @relation("UsuarioCreadoPor")
  usuariosModificados        Usuario[]           @relation("UsuarioModificadoPor")
  rolesCreados               Rol[]               @relation("RolCreadoPor")
  rolesModificados           Rol[]               @relation("RolModificadoPor")
  oficinasCreadas            Oficina[]           @relation("OficinaCreadoPor")
  oficinasModificadas        Oficina[]           @relation("OficinaModificadoPor")
  contribuyentesCreados      Contribuyente[]     @relation("ContribuyenteCreadoPor")
  contribuyentesModificados  Contribuyente[]     @relation("ContribuyenteModificadoPor")
  excepcionesAprobadas       Contribuyente[]     @relation("ContribuyenteExcepcionAprobadaPor")
  prediosCreados             Predio[]            @relation("PredioCreadoPor")
  direccionesCreadas         Direccion[]         @relation("DireccionCreadoPor")
  direccionesModificadas     Direccion[]         @relation("DireccionModificadoPor")
  djCreadas                  DjPresentada[]      @relation("DjCreadoPor")
  djModificadas              DjPresentada[]      @relation("DjModificadoPor")
  djAnuladas                 DjPresentada[]      @relation("DjAnuladaPor")
  djRevisionesResueltas      DjPresentada[]      @relation("DjRevisionResueltaPor")
  djLiquidadas               DjPresentada[]      @relation("DjLiquidadaPor")
  prorrogasCreadas           ProrrogaDj[]        @relation("ProrrogaCreadoPor")
  prorrogasModificadas       ProrrogaDj[]        @relation("ProrrogaModificadoPor")
  prorrogasResueltas         ProrrogaDj[]        @relation("ProrrogaResueltaPor")
  prorrogasAnuladas          ProrrogaDj[]        @relation("ProrrogaAnuladaPor")
  determinacionesCreadas     Determinacion[]     @relation("DeterminacionCreadoPor")
  determinacionesModificadas Determinacion[]     @relation("DeterminacionModificadoPor")
  prediosModificados         Predio[]            @relation("PredioModificadoPor")
  vehiculosCreados           Vehiculo[]          @relation("VehiculoCreadoPor")
  vehiculosModificados       Vehiculo[]          @relation("VehiculoModificadoPor")
  cuentasCreadas             CuentaCorriente[]   @relation("CuentaCreadoPor")
  cuentasModificadas         CuentaCorriente[]   @relation("CuentaModificadoPor")
  pagosModificados           Pago[]              @relation("PagoModificadoPor")
  conveniosModificados       ConvenioCab[]       @relation("ConvenioModificadoPor")
  valoresCreados             ValorCab[]          @relation("ValorCreadoPor")
  valoresModificados         ValorCab[]          @relation("ValorModificadoPor")
  expedientesCreados         CoactivoExp[]       @relation("ExpedienteCreadoPor")
  expedientesModificados     CoactivoExp[]       @relation("ExpedienteModificadoPor")
  licenciasCreadas           Licencia[]          @relation("LicenciaCreadoPor")
  licenciasModificadas       Licencia[]          @relation("LicenciaModificadoPor")
  declaracionesCreadas       DeclaracionJurada[] @relation("DeclaracionCreadoPor")
  declaracionesModificadas   DeclaracionJurada[] @relation("DeclaracionModificadoPor")
  fiscalizacionesCreadas     Fiscalizacion[]     @relation("FiscalizacionCreadoPor")
  fiscalizacionesModificadas Fiscalizacion[]     @relation("FiscalizacionModificadoPor")
  fiscalizador               Fiscalizador?

  @@index([rolId])
  @@index([oficinaId])
  @@map("usuarios")
}

// Solo inserción: un trigger bloquea UPDATE/DELETE/TRUNCATE. Fecha = now() del servidor.
// CREATE/UPDATE/DELETE los escribe el trigger auditoria_registrar; LOGIN* y LOGOUT, la app.
model Auditoria {
  id            BigInt          @id @default(autoincrement())
  usuarioId     Int? // actor; null = SISTEMA/anónimo
  usuario       Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  usuarioNombre String?         @db.VarChar(50) // snapshot; en LOGIN_FALLIDO = usuario intentado
  accion        AccionAuditoria
  tabla         String          @db.VarChar(60)
  registroId    String?         @db.VarChar(50) // PK compuesta → "rolId:nivelId"
  modulo        String?         @db.VarChar(100) // código de nivel, 'auth' o null
  ip            String?         @db.VarChar(45)
  userAgent     String?         @db.VarChar(255)
  datosAntes    Json? // UPDATE: solo campos cambiados
  datosDespues  Json?
  detalle       Json? // motivo de fallo, usuario de BD en scripts
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)

  @@index([createdAt])
  @@index([usuarioId, createdAt])
  @@index([tabla, registroId])
  @@index([accion, createdAt])
  @@map("auditoria")
}

// ============================================================
// B. CONTRIBUYENTES
// Ref SIMUN: generales.DBF (maestro) + contribuyentes.DBF (resumen DJ)
// Se normaliza: una fila por persona, sin descripciones duplicadas.
// ============================================================

// Catálogo de ubigeo (1872 distritos, leídos de SIMUN DISTRITO.DBF).
// Solo referencia: contribuyentes.ubigeo NO tiene FK para no romper filas heredadas sin catalogar.
model Ubigeo {
  codigo       String @id @db.VarChar(6) // DEP(2)+PRO(2)+DIS(2)
  departamento String @db.VarChar(40)
  provincia    String @db.VarChar(40)
  distrito     String @db.VarChar(40)

  @@index([distrito])
  @@map("ubigeos")
}

// Caché de aciertos de la consulta de identidad (specs/consulta-identidad-v1.md).
// PK compuesta en vez de id: el documento es lo único que se repite. Solo se guardan aciertos,
// nunca un "no encontrado", para no bloquear 30 días un DNI recién emitido.
model ConsultaIdentidad {
  tipoDoc      String   @db.VarChar(10) // DNI, RUC
  numDoc       String   @db.VarChar(20)
  datos        Json // {tipoPersona, nombreCompleto, estado, condicion, direccionExterna}
  consultadoAt DateTime @default(now())

  @@id([tipoDoc, numDoc])
  @@index([consultadoAt])
  @@map("consultas_identidad")
}

// Personas v2 (specs/rentas-nucleo-v2.md, Fase 1; reglas P01–P18 en docs/rentas/reglas-negocio.md).
// tipoDoc/numDoc = copia del documento principal (el primero de `documentos`) para los lectores de
// v1 (caja, valores, coactiva…); la unicidad vive en contribuyente_documentos (P06).
// nombreCompleto se arma solo (P05). Los códigos de catálogo se guardan como texto (Fase 0).
model Contribuyente {
  id              Int         @id @default(autoincrement())
  codigoLegacy    String?     @unique @db.VarChar(7) // CODCLI SIMUN, solo referencia historica
  tipoPersona     TipoPersona @default(NATURAL)
  tipoDoc         String      @db.VarChar(20) // documento principal; SIN_DOCUMENTO si no tiene (P08)
  numDoc          String?     @db.VarChar(20) // null = sin documento
  apellidoPaterno String?     @db.VarChar(60) // natural; sucesión: del causante
  apellidoMaterno String?     @db.VarChar(60)
  nombres         String?     @db.VarChar(80)
  razonSocial     String?     @db.VarChar(120) // jurídica
  tipoSucesion    String?     @db.VarChar(20) // catálogo TIPO_SUCESION (abreviatura en el nombre)
  nombreCompleto  String      @db.VarChar(120) // derivado (P05)
  nombreRevisado  Boolean     @default(true) // false = nombre convertido de v1, falta revisarlo (decisión 7)
  fechaNacimiento DateTime?   @db.Date // adulto mayor (P15)
  dniCausante     String?     @db.VarChar(8) // sucesión: referencia, no cuenta para P06 (P18)
  direccionFiscal String?     @db.VarChar(150) // copia de la línea del domicilio: la leen caja, valores y estado de cuenta
  ubigeo          String?     @default("150129") @db.VarChar(6) // distrito del domicilio

  // Domicilio fiscal (P11): en el distrito, una dirección única del catálogo (D01); foráneo, ubigeo + texto.
  direccionId    Int?
  direccion      Direccion? @relation(fields: [direccionId], references: [id], onDelete: Restrict)
  domicilioTexto String?    @db.VarChar(250) // foráneo, o heredado de v1 sin estructura (por revisar)

  // Perfil y clasificación (P12): catálogos PERFIL_CUMPLIMIENTO, PERFIL_COBRANZA, CLASIFICACION_CONTRIBUYENTE
  perfilCumplimiento String? @db.VarChar(20)
  perfilCobranza     String? @db.VarChar(20)
  clasificacion      String? @db.VarChar(20)

  // Sin documento (P08): justificación obligatoria; un SUPERVISOR aprueba la excepción.
  sinDocumentoMotivo     String?   @db.VarChar(250)
  excepcionAprobadaPorId Int?
  excepcionAprobadaPor   Usuario?  @relation("ContribuyenteExcepcionAprobadaPor", fields: [excepcionAprobadaPorId], references: [id], onDelete: Restrict)
  excepcionAprobadaAt    DateTime?

  estado          EstadoPersona @default(HABILITADO)
  motivoEstado    String?       @db.VarChar(250) // por qué se inhabilitó
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  creadoPorId     Int?
  creadoPor       Usuario?      @relation("ContribuyenteCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId Int?
  modificadoPor   Usuario?      @relation("ContribuyenteModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  documentos      ContribuyenteDocumento[]
  contactos       ContribuyenteContacto[]
  relacionados    ContribuyenteRelacionado[] @relation("RelacionadosDe")
  relacionadoEn   ContribuyenteRelacionado[] @relation("RelacionadoPersona")
  beneficios      ContribuyenteBeneficio[]
  predios         PredioContribuyente[]
  vehiculos       Vehiculo[]
  cuentas         CuentaCorriente[]
  pagos           Pago[]                     @relation("PagadorContribuyente")
  recibos         Recibo[]
  fiscalizaciones Fiscalizacion[]
  valores         ValorCab[]
  convenios       ConvenioCab[]
  coactivoExps    CoactivoExp[]
  licencias       Licencia[]
  declaraciones   DeclaracionJurada[]
  djPresentadas   DjPresentada[]
  prorrogasDj     ProrrogaDj[]
  djAdquirienteEn DjAdquiriente[]            @relation("DjAdquirientePersona")
  determinaciones Determinacion[]

  @@index([numDoc])
  @@index([nombreCompleto])
  @@index([estado])
  @@index([direccionId])
  @@map("contribuyentes")
}

// P06: varios documentos por persona; el par tipo + número no se repite en toda la base.
model ContribuyenteDocumento {
  id              Int           @id @default(autoincrement())
  contribuyenteId Int
  contribuyente   Contribuyente @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  orden           Int // 1 = principal
  tipoDoc         String        @db.VarChar(20) // catálogo TIPO_DOCUMENTO
  numDoc          String        @db.VarChar(20)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@unique([tipoDoc, numDoc])
  @@index([contribuyenteId])
  @@index([numDoc])
  @@map("contribuyente_documentos")
}

// P09: varios contactos por tipo.
model ContribuyenteContacto {
  id              Int           @id @default(autoincrement())
  contribuyenteId Int
  contribuyente   Contribuyente @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  orden           Int
  tipo            String        @db.VarChar(20) // catálogo TIPO_CONTACTO
  valor           String        @db.VarChar(100)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([contribuyenteId])
  @@map("contribuyente_contactos")
}

// P10: cónyuge, representante legal, responsable… Sus datos van en la ficha; si su documento es de
// una persona registrada, se enlaza (personaId). Solo un cónyuge vigente (lo valida el servicio).
model ContribuyenteRelacionado {
  id              Int            @id @default(autoincrement())
  contribuyenteId Int
  contribuyente   Contribuyente  @relation("RelacionadosDe", fields: [contribuyenteId], references: [id], onDelete: Restrict)
  orden           Int
  tipo            String         @db.VarChar(20) // catálogo TIPO_RELACIONADO
  tipoDoc         String?        @db.VarChar(20)
  numDoc          String?        @db.VarChar(20)
  nombreCompleto  String         @db.VarChar(120)
  direccion       String?        @db.VarChar(150)
  personaId       Int?
  persona         Contribuyente? @relation("RelacionadoPersona", fields: [personaId], references: [id], onDelete: SetNull)
  vigente         Boolean        @default(true)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt

  @@index([contribuyenteId])
  @@index([personaId])
  @@map("contribuyente_relacionados")
}

// P14 (inafectación del art. 17) y P15 (deducción de pensionista o adulto mayor): por resolución.
// Se aplican al determinar (Fase 5). No se borran: se revocan (vigente = false).
model ContribuyenteBeneficio {
  id              Int           @id @default(autoincrement())
  contribuyenteId Int
  contribuyente   Contribuyente @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  codigo          String        @db.VarChar(20) // catálogo BENEFICIO
  baseLegal       String        @db.VarChar(150)
  expediente      String?       @db.VarChar(30)
  resolucion      String        @db.VarChar(40)
  fechaResolucion DateTime      @db.Date
  anioDesde       Int
  anioHasta       Int?
  vigente         Boolean       @default(true)
  observacion     String?       @db.VarChar(250)
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt

  @@index([contribuyenteId])
  @@map("contribuyente_beneficios")
}

// ============================================================
// B2. DIRECCIONES ÚNICAS (specs/rentas-nucleo-v2.md, Fase 2; reglas D01–D05)
// Un registro por dirección del distrito, compartido por personas (y luego predios y relacionados).
// La literal se arma con vía + componentes ordenados + habilitación + distrito (D04).
// ============================================================

model Direccion {
  id              Int           @id @default(autoincrement())
  ubigeo          String        @db.VarChar(6) // distrito (D02): el de la muni, regla muni.ubigeo
  zonaId          Int? // sector: define la zona de arbitrios (D03)
  zona            Zona?         @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  urbanizacionId  Int? // habilitación urbana (urb., AA.HH., A.F.)
  urbanizacion    Urbanizacion? @relation(fields: [urbanizacionId], references: [id], onDelete: Restrict)
  viaId           Int?
  via             Via?          @relation(fields: [viaId], references: [id], onDelete: Restrict)
  direccion       String        @db.VarChar(250) // literal armada sola (D04); no se escribe a mano
  clave           String        @unique // identidad: ubigeo|zona|habilitación|vía|componentes por código
  referencia      String?       @db.VarChar(250) // D05
  latitud         Decimal?      @db.Decimal(9, 6) // D05: opcionales, van juntas
  longitud        Decimal?      @db.Decimal(9, 6)
  activo          Boolean       @default(true) // baja lógica: no se asigna a nadie nuevo
  createdAt       DateTime      @default(now())
  updatedAt       DateTime      @updatedAt
  creadoPorId     Int?
  creadoPor       Usuario?      @relation("DireccionCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId Int?
  modificadoPor   Usuario?      @relation("DireccionModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  componentes    DireccionComponente[]
  contribuyentes Contribuyente[]
  predios        Predio[]

  @@index([direccion])
  @@index([zonaId])
  @@index([urbanizacionId])
  @@index([viaId])
  @@map("direcciones")
}

// D04: número, Mz., Lt., Dpto.… en el orden en que se leen. Un componente no se repite.
model DireccionComponente {
  id          Int       @id @default(autoincrement())
  direccionId Int
  direccion   Direccion @relation(fields: [direccionId], references: [id], onDelete: Restrict)
  orden       Int
  componente  String    @db.VarChar(20) // catálogo COMPONENTE_DIRECCION
  valor       String    @db.VarChar(20)
  createdAt   DateTime  @default(now())
  updatedAt   DateTime  @updatedAt

  @@unique([direccionId, componente])
  @@map("direccion_componentes")
}

// ============================================================
// C. CATASTRO / PREDIOS
// Ref SIMUN: predios_urbanos_rusticos.dbf + pisos.dbf +
//   otras_instalaciones.dbf + condominos.dbf + declaracion_j.dbf
// declaracion_j es snapshot historico: NO se modela como tabla,
// se reconstruye con Predio + Piso + PredioContribuyente + Auditoria.
// ============================================================

model Zona {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique @db.VarChar(5) // CODZON SIMUN
  nombre    String   @db.VarChar(100)
  createdAt DateTime @default(now())

  predios     Predio[]
  tarifas     TarifaArbitrio[]
  direcciones Direccion[]

  @@map("zonas")
}

model Urbanizacion {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique @db.VarChar(10) // CODURB SIMUN
  nombre    String   @db.VarChar(100)
  createdAt DateTime @default(now())

  predios     Predio[]
  aranceles   Arancel[]
  direcciones Direccion[]

  @@map("urbanizaciones")
}

model Via {
  id        Int      @id @default(autoincrement())
  tipoVia   String   @db.VarChar(10) // AV, JR, CL, PSJE (tabla_tipo_de_vias)
  nombre    String   @db.VarChar(100) // CALLES.DBF
  createdAt DateTime @default(now())

  predios     Predio[]
  aranceles   Arancel[]
  direcciones Direccion[]

  @@unique([tipoVia, nombre])
  @@map("vias")
}

// R01: urbano o rústico (TUO LTM art. 8).
enum TipoPredio {
  URBANO
  RUSTICO
}

// Predio maestro (specs/rentas-nucleo-v2.md, Fase 3; R01–R06). Lo de identificación y arbitrios
// (nombre, linderos, coordenadas, frecuencia, parques, frontis) se edita en el maestro; ubicación,
// área y construcción siguen entrando por la DJ. zonaId…referencia quedan como copia de la
// dirección única (D01) porque los leen el cálculo, caja, valores y fiscalización.
model Predio {
  id                         Int            @id @default(autoincrement())
  codigoLegacy               String?        @unique @db.VarChar(7) // CODPRED SIMUN
  codigoCatastro             String?        @unique @db.VarChar(20) // IDCATASTRO
  tipo                       TipoPredio     @default(URBANO)
  nombre                     String?        @db.VarChar(120) // tb_nombre_predios_unicos
  direccionId                Int?
  direccion                  Direccion?     @relation(fields: [direccionId], references: [id], onDelete: Restrict)
  latitud                    Decimal?       @db.Decimal(9, 6)
  longitud                   Decimal?       @db.Decimal(9, 6)
  // Linderos (R01): metros y colindante de cada lado.
  linderoFrenteMetros        Decimal?       @db.Decimal(10, 2)
  linderoFrenteColindante    String?        @db.VarChar(120)
  linderoDerechaMetros       Decimal?       @db.Decimal(10, 2)
  linderoDerechaColindante   String?        @db.VarChar(120)
  linderoIzquierdaMetros     Decimal?       @db.Decimal(10, 2)
  linderoIzquierdaColindante String?        @db.VarChar(120)
  linderoFondoMetros         Decimal?       @db.Decimal(10, 2)
  linderoFondoColindante     String?        @db.VarChar(120)
  // Arbitrios (R02): la zona sale del sector de la dirección (D03).
  frecuenciaBarrido          String?        @db.VarChar(20) // catálogo FRECUENCIA_BARRIDO
  ubicacionParque            String?        @db.VarChar(20) // catálogo UBICACION_PARQUE
  frontis                    Decimal?       @db.Decimal(10, 2) // metros lineales
  zonaId                     Int?
  zona                       Zona?          @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  urbanizacionId             Int?
  urbanizacion               Urbanizacion?  @relation(fields: [urbanizacionId], references: [id], onDelete: Restrict)
  viaId                      Int?
  via                        Via?           @relation(fields: [viaId], references: [id], onDelete: Restrict)
  numero                     String?        @db.VarChar(10)
  manzana                    String?        @db.VarChar(10)
  lote                       String?        @db.VarChar(10)
  referencia                 String?        @db.VarChar(150)
  areaTerreno                Decimal?       @db.Decimal(12, 2)
  areaConstruida             Decimal?       @db.Decimal(12, 2)
  valorAutovaluo             Decimal?       @db.Decimal(14, 2)
  usoPredio                  String?        @db.VarChar(10) // uso_del_predio.dbf
  estado                     EstadoRegistro @default(ACTIVO)
  createdAt                  DateTime       @default(now())
  updatedAt                  DateTime       @updatedAt
  creadoPorId                Int?
  creadoPor                  Usuario?       @relation("PredioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId            Int?
  modificadoPor              Usuario?       @relation("PredioModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  contribuyentes     PredioContribuyente[]
  pisos              Piso[]
  otrasInstalaciones OtraInstalacion[]
  cuentas            CuentaCorriente[]
  valores            ValorCab[]
  licencias          Licencia[]
  declaraciones      DeclaracionJurada[]
  fiscalizaciones    FiscalizacionPredio[]
  beneficios         PredioBeneficio[]
  djAnexos           DjAnexo[]
  determinaciones    DeterminacionPredio[]
  arbitriosMes       DeterminacionArbitrio[]

  @@index([zonaId])
  @@index([urbanizacionId])
  @@index([estado])
  @@index([direccionId])
  @@map("predios")
}

// R06: inafectación o exoneración del predio por resolución. Un predio inafecto exige que sus
// titulares sean inafectos. Se aplica al determinar (Fase 5). No se borra: se revoca.
model PredioBeneficio {
  id              Int      @id @default(autoincrement())
  predioId        Int
  predio          Predio   @relation(fields: [predioId], references: [id], onDelete: Restrict)
  codigo          String   @db.VarChar(20) // catálogo BENEFICIO (régimen INAFECTACION o EXONERACION)
  porcentaje      Decimal  @db.Decimal(5, 2)
  baseLegal       String   @db.VarChar(150)
  expediente      String?  @db.VarChar(30)
  resolucion      String   @db.VarChar(40)
  fechaResolucion DateTime @db.Date
  anioDesde       Int
  anioHasta       Int?
  vigente         Boolean  @default(true)
  observacion     String?  @db.VarChar(250)
  createdAt       DateTime @default(now())
  updatedAt       DateTime @updatedAt

  @@index([predioId])
  @@map("predio_beneficios")
}

model PredioContribuyente {
  id               Int            @id @default(autoincrement())
  contribuyenteId  Int
  contribuyente    Contribuyente  @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  predioId         Int
  predio           Predio         @relation(fields: [predioId], references: [id], onDelete: Restrict)
  porcentaje       Decimal        @default(100.0) @db.Decimal(6, 2) // PORPRO SIMUN
  fechaAdquisicion DateTime?      @db.Date
  fechaFin         DateTime?      @db.Date // deja de ser titular (venta, baja): "personas asociadas" por año
  condicion        String?        @db.VarChar(20) // R05: catálogo CONDICION_PROPIEDAD
  esPrincipal      Boolean        @default(true)
  estado           EstadoRegistro @default(ACTIVO)
  createdAt        DateTime       @default(now())

  @@unique([contribuyenteId, predioId])
  @@index([predioId])
  @@map("predio_contribuyente")
}

model Piso {
  id                 Int      @id @default(autoincrement())
  predioId           Int
  predio             Predio   @relation(fields: [predioId], references: [id], onDelete: Cascade)
  nivel              String   @db.VarChar(10) // NIVEL: 01, 02...
  anioConstruccion   Int?
  clasificacion      String?  @db.VarChar(30) // rentas/catalogos-construccion.ts
  material           String?  @db.VarChar(20)
  estadoConservacion String?  @db.VarChar(15)
  categorias         String?  @db.VarChar(7) // A-I por componente (orden ComponenteConstruccion), "-" = no tiene
  areaConstruida     Decimal? @db.Decimal(10, 2)
  valorUnitario      Decimal? @db.Decimal(10, 2)
  valorConstruccion  Decimal? @db.Decimal(12, 2)
  createdAt          DateTime @default(now())
  updatedAt          DateTime @updatedAt

  otrasInstalaciones OtraInstalacion[]

  @@index([predioId])
  @@map("pisos")
}

model OtraInstalacion {
  id          Int      @id @default(autoincrement())
  predioId    Int
  predio      Predio   @relation(fields: [predioId], references: [id], onDelete: Cascade)
  pisoId      Int?
  piso        Piso?    @relation(fields: [pisoId], references: [id], onDelete: SetNull)
  descripcion String   @db.VarChar(150) // CLAOTRAS + CODOTRAS
  unidad      String?  @db.VarChar(10)
  cantidad    Decimal? @db.Decimal(10, 2)
  valor       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())

  @@index([predioId])
  @@map("otras_instalaciones")
}

// ============================================================
// D. VEHICULAR
// Ref SIMUN: impuesto_vehicular.dbf + detalle_vehicular.dbf +
//   tabla_marca_vehicular + tabla_valor_mef_vehicular
// ============================================================

model Vehiculo {
  id               Int            @id @default(autoincrement())
  contribuyenteId  Int
  contribuyente    Contribuyente  @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  placa            String         @unique @db.VarChar(15) // NRO_PLACA
  marca            String         @db.VarChar(50)
  modelo           String         @db.VarChar(80)
  anioFabricacion  Int
  numMotor         String?        @db.VarChar(30)
  numTarjeta       String?        @db.VarChar(20)
  valorAdquisicion Decimal?       @db.Decimal(12, 2)
  estado           EstadoRegistro @default(ACTIVO)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creadoPorId      Int?
  creadoPor        Usuario?       @relation("VehiculoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId  Int?
  modificadoPor    Usuario?       @relation("VehiculoModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  detalles VehiculoDetalleAnual[]
  cuentas  CuentaCorriente[]

  @@index([contribuyenteId])
  @@map("vehiculos")
}

model VehiculoDetalleAnual {
  id             Int      @id @default(autoincrement())
  vehiculoId     Int
  vehiculo       Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)
  anioFiscal     Int
  baseImponible  Decimal  @db.Decimal(12, 2)
  impuesto       Decimal  @db.Decimal(12, 2)
  derechoEmision Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())

  @@unique([vehiculoId, anioFiscal])
  @@map("vehiculo_detalle_anual")
}

// ============================================================
// E. PARAMETRIA TRIBUTARIA
// Ref SIMUN: tributo.DBF + UIT.DBF + impuesto.DBF (escala) +
//   TARIFAS_ARB.DBF + TUPA.DBF
// ============================================================

model Tributo {
  id        Int         @id @default(autoincrement())
  codigo    String      @unique @db.VarChar(10) // CODTRI SIMUN
  nombre    String      @db.VarChar(100)
  tipo      TipoTributo @default(OTRO)
  activo    Boolean     @default(true)
  createdAt DateTime    @default(now())

  cuentas CuentaCorriente[]

  @@map("tributos")
}

model Uit {
  id                   Int      @id @default(autoincrement())
  anio                 Int      @unique
  valor                Decimal  @db.Decimal(10, 2)
  derechoEmision       Decimal  @default(0) @db.Decimal(10, 2) // monto fijo anual por contribuyente (cuota 1 del predial)
  // V03 y V05 (specs/rentas-nucleo-v2.md, Fase 7): los fija la RM de valores unitarios de cada año.
  incrementoDesdePiso  Int? // V03: desde este piso el valor unitario sube; null = no aplica
  incrementoPisoPct    Decimal? @db.Decimal(5, 2) // V03: % de incremento
  factorOficializacion Decimal? @db.Decimal(6, 4) // V05: factor de oficialización de las obras complementarias
  ordenanza            String?  @db.VarChar(60) // norma que lo aprueba
  createdAt            DateTime @default(now())

  @@map("uit")
}

model EscalaPredial {
  id        Int      @id @default(autoincrement())
  anio      Int
  tramo     Int // 1, 2, 3... (IMP_RANGO SIMUN)
  desdeUit  Decimal  @db.Decimal(8, 2)
  hastaUit  Decimal? @db.Decimal(8, 2) // null = sin tope
  tasa      Decimal  @db.Decimal(6, 4) // tasa marginal en % (0.2 = 0,2%)
  ordenanza String?  @db.VarChar(60) // norma que lo aprueba
  createdAt DateTime @default(now())

  @@unique([anio, tramo])
  @@map("escala_predial")
}

// L07: cada concepto se distribuye con los criterios de su ordenanza. Criterios vacíos = todos; gana
// la tarifa más específica. `unidad` dice sobre qué se cobra la tasa anual: el predio (como en v1),
// el m² del uso o el metro lineal de frontis. La v1 solo usa las tarifas por predio.
model TarifaArbitrio {
  id              Int      @id @default(autoincrement())
  anio            Int
  concepto        String   @db.VarChar(30) // RESIDUOS, BARRIDO, PARQUES, SERENAZGO
  zonaId          Int? // null = todas las zonas
  zona            Zona?    @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  uso             String?  @db.VarChar(10) // catálogo USO_PREDIO; null = todos los usos
  frecuencia      String?  @db.VarChar(20) // catálogo FRECUENCIA_BARRIDO (R02); null = todas
  ubicacionParque String?  @db.VarChar(20) // catálogo UBICACION_PARQUE (R02, D03); null = todas
  unidad          String   @default("PREDIO") @db.VarChar(10) // PREDIO | M2 | ML
  tasa            Decimal  @db.Decimal(10, 2) // monto anual por unidad
  ordenanza       String?  @db.VarChar(60) // norma que lo aprueba
  createdAt       DateTime @default(now())

  @@index([anio, concepto])
  @@map("tarifas_arbitrios")
}

// V07: arancel rústico del año por categoría y clasificación de tierras (S/ por hectárea).
model ArancelRustico {
  id            Int      @id @default(autoincrement())
  anio          Int
  categoria     String   @db.VarChar(20)
  clasificacion String?  @db.VarChar(20) // null = cualquier clasificación de esa categoría
  valorHa       Decimal  @db.Decimal(12, 2)
  ordenanza     String?  @db.VarChar(60)
  createdAt     DateTime @default(now())

  @@index([anio, categoria])
  @@map("aranceles_rusticos")
}

// Arancel urbano por vía (y urbanización) — aranceles urbanos SIMUN
model Arancel {
  id             Int           @id @default(autoincrement())
  anio           Int
  viaId          Int
  via            Via           @relation(fields: [viaId], references: [id], onDelete: Restrict)
  urbanizacionId Int?
  urbanizacion   Urbanizacion? @relation(fields: [urbanizacionId], references: [id], onDelete: Restrict)
  valorM2        Decimal       @db.Decimal(12, 2)
  ordenanza      String?       @db.VarChar(60)
  createdAt      DateTime      @default(now())

  @@index([anio, viaId])
  @@map("aranceles")
}

// Valores unitarios oficiales de edificación (categorías A-I por componente)
model ValorUnitario {
  id         Int                    @id @default(autoincrement())
  anio       Int
  componente ComponenteConstruccion
  categoria  String                 @db.VarChar(1) // A..I
  valor      Decimal                @db.Decimal(12, 2) // S/ por m2
  ordenanza  String?                @db.VarChar(60)
  createdAt  DateTime               @default(now())

  @@unique([anio, componente, categoria])
  @@map("valores_unitarios")
}

// V05: valores unitarios de obras complementarias del año (Reglamento Nacional de Tasaciones), por
// unidad de medida. El valor oficial es valor × cantidad × factor de oficialización (Uit) con depreciación.
model ValorObra {
  id          Int      @id @default(autoincrement())
  anio        Int
  codigo      String   @db.VarChar(10)
  descripcion String   @db.VarChar(120)
  unidad      String   @db.VarChar(10) // m2, ml, m3, und…
  valor       Decimal  @db.Decimal(12, 2) // S/ por unidad
  ordenanza   String?  @db.VarChar(60)
  createdAt   DateTime @default(now())

  @@unique([anio, codigo])
  @@map("valores_obras")
}

// % de depreciación por clasificación, material, antigüedad y estado de conservación
model Depreciacion {
  id                 Int      @id @default(autoincrement())
  anio               Int
  clasificacion      String   @db.VarChar(30) // Piso.clasificacion
  material           String   @db.VarChar(20) // Piso.material
  antiguedadHasta    Int // años (tope del rango)
  estadoConservacion String   @db.VarChar(15) // Piso.estadoConservacion
  porcentaje         Decimal  @db.Decimal(5, 2)
  ordenanza          String?  @db.VarChar(60)
  createdAt          DateTime @default(now())

  @@unique([anio, clasificacion, material, antiguedadHasta, estadoConservacion])
  @@map("depreciaciones")
}

// TIM (mensual, %) e IPM (índice del mes); vigente desde la fecha hasta la siguiente
model TasaMora {
  id            Int          @id @default(autoincrement())
  tipo          TipoTasaMora
  vigenciaDesde DateTime     @db.Date
  valor         Decimal      @db.Decimal(12, 5)
  ordenanza     String?      @db.VarChar(60)
  createdAt     DateTime     @default(now())

  @@unique([tipo, vigenciaDesde])
  @@map("tasas_mora")
}

// Días no hábiles para plazos (RD: 20 días hábiles para reclamar). Sábado y domingo no se registran.
model Feriado {
  id          Int      @id @default(autoincrement())
  fecha       DateTime @unique @db.Date
  descripcion String   @db.VarChar(100)
  createdAt   DateTime @default(now())

  @@map("feriados")
}

// Límites del fraccionamiento por año (ordenanza municipal, Código Tributario art. 36)
model ParametroFraccionamiento {
  id                 Int      @id @default(autoincrement())
  anio               Int      @unique
  cuotaInicialMinPct Decimal  @db.Decimal(5, 2) // % mínimo del total
  cuotasMax          Int
  montoMinimo        Decimal  @db.Decimal(12, 2)
  interesMensual     Decimal  @db.Decimal(7, 4) // % mensual sobre saldo
  ordenanza          String?  @db.VarChar(60)
  createdAt          DateTime @default(now())

  @@map("parametros_fraccionamiento")
}

// Numeración correlativa por serie y año (OP, RD, CONV, MEMO; Caja la reusará)
model Correlativo {
  serie  String @db.VarChar(10)
  anio   Int
  ultimo Int    @default(0)

  @@id([serie, anio])
  @@map("correlativos")
}

// ============================================================
// DJ PRESENTADA (specs/rentas-nucleo-v2.md, Fases 4 y 5; reglas J01–J17, R03, R04)
// Una DJ por contribuyente con un anexo por predio (J01). Lo declarado no se edita una vez
// liquidado: se reabre (J05) o se rectifica con otra DJ. Se determina y liquida (Fase 5); la
// DeclaracionJurada de v1 (por predio) sigue para su formulario y la fiscalización hasta la Fase 6.
// ============================================================

enum EstadoDj {
  PENDIENTE
  EN_REVISION // J14: baja la obligación de un período liquidado (Fase 5)
  LIQUIDADA
  ANULADA
  RECHAZADA
}

model DjPresentada {
  id                    Int            @id @default(autoincrement())
  anio                  Int // año del correlativo (J02: AA-NNNNNNN)
  numero                Int
  contribuyenteId       Int
  contribuyente         Contribuyente  @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  motivo                String         @db.VarChar(20) // catálogo MOTIVO_DJ
  subMotivo             String?        @db.VarChar(20) // catálogo SUB_MOTIVO_DJ (hijo del motivo)
  tipo                  String         @db.VarChar(20) // J07: INFORMATIVA o DECLARATIVA, copiado del motivo al registrar
  numeroFormulario      String?        @db.VarChar(20) // J02: formulario físico
  folios                Int?
  fechaPresentacion     DateTime       @db.Date // recepción
  persona               Json // J03: copia de la persona y sus relacionados al presentar
  estado                EstadoDj       @default(PENDIENTE)
  observacion           String?        @db.VarChar(250)
  djPrevioId            Int? // la DJ que rectifica o sustituye
  djPrevio              DjPresentada?  @relation("DjRectifica", fields: [djPrevioId], references: [id], onDelete: Restrict)
  rectificadaPor        DjPresentada[] @relation("DjRectifica")
  anuladaMotivo         String?        @db.VarChar(250)
  anuladaPorId          Int?
  anuladaPor            Usuario?       @relation("DjAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  anuladaAt             DateTime?
  // J14/J17 (Fase 5): baja la obligación de un período liquidado → revisión con plazo de 45 días
  // hábiles desde la recepción; la resuelve un supervisor distinto de quien la registró.
  revisionVence         DateTime?      @db.Date
  revisionResueltaPorId Int?
  revisionResueltaPor   Usuario?       @relation("DjRevisionResueltaPor", fields: [revisionResueltaPorId], references: [id], onDelete: Restrict)
  revisionResueltaAt    DateTime?
  revisionJustificacion String?        @db.VarChar(250)
  // Liquidación (C7). `aplicado` = el padrón antes de la primera liquidación (titulares, predios,
  // copia física, estado de la persona): anular la DJ lo devuelve a como estaba (J04).
  liquidadaAt           DateTime?
  liquidadaPorId        Int?
  liquidadaPor          Usuario?       @relation("DjLiquidadaPor", fields: [liquidadaPorId], references: [id], onDelete: Restrict)
  aplicado              Json?
  multaDescartada       String?        @db.VarChar(200) // J08: DJ fuera de plazo sin multa 176.1, con motivo
  // J08 (Fase 7): autoavalúo antes y después de una modificación, guardado al determinar (5 UIT).
  variacion             Json?
  // Fase 7: DJ de descargo generada de oficio desde la adquisición de otra persona (su transferente).
  generadaDesdeId       Int?
  generadaDesde         DjPresentada?  @relation("DjGenerada", fields: [generadaDesdeId], references: [id], onDelete: Restrict)
  generadas             DjPresentada[] @relation("DjGenerada")
  createdAt             DateTime       @default(now())
  updatedAt             DateTime       @updatedAt
  creadoPorId           Int?
  creadoPor             Usuario?       @relation("DjCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId       Int?
  modificadoPor         Usuario?       @relation("DjModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  anexos          DjAnexo[]
  documentos      DjDocumento[]
  determinaciones Determinacion[]
  multas          ValorCab[]

  @@unique([anio, numero])
  @@index([contribuyenteId])
  @@index([estado])
  @@index([generadaDesdeId])
  @@map("dj_presentadas")
}

// Un renglón por predio declarado: tenencia (R04, R05, J10–J12) y características (ficha).
model DjAnexo {
  id                       Int          @id @default(autoincrement())
  djId                     Int
  dj                       DjPresentada @relation(fields: [djId], references: [id], onDelete: Restrict)
  numero                   Int // anexo 1, 2…
  predioId                 Int
  predio                   Predio       @relation(fields: [predioId], references: [id], onDelete: Restrict)
  predioNuevo              Boolean      @default(false) // lo creó esta DJ (queda INACTIVO hasta liquidar)
  subMotivo                String?      @db.VarChar(20)
  condicion                String       @db.VarChar(20) // R05: catálogo CONDICION_PROPIEDAD
  porcentaje               Decimal      @db.Decimal(6, 2) // R04: % de propiedad de este contribuyente
  fechaAdquisicion         DateTime?    @db.Date
  fechaDocumento           DateTime?    @db.Date // documento sustentatorio
  fechaDescargo            DateTime?    @db.Date // J12: venta o baja
  anioAfectacion           Int // J10: impuesto predial desde este año
  fechaAfectacionArbitrios DateTime     @db.Date // J11: arbitrios desde este mes (día 1)
  valorTransferencia       Decimal?     @db.Decimal(14, 2)
  moneda                   String?      @db.VarChar(3) // PEN, USD
  partidaRegistral         String?      @db.VarChar(30)
  areaTerreno              Decimal      @db.Decimal(12, 2)
  areaComun                Decimal?     @db.Decimal(12, 2)
  numeroPisos              Int?
  observacion              String?      @db.VarChar(250)
  createdAt                DateTime     @default(now())
  updatedAt                DateTime     @updatedAt

  niveles      DjNivel[]
  obras        DjObra[]
  usos         DjUso[]
  rusticos     DjArancelRustico[]
  adquirientes DjAdquiriente[]

  @@unique([djId, numero])
  @@unique([djId, predioId])
  @@index([predioId])
  @@map("dj_anexos")
}

// Niveles de construcción (V01–V04): categorías por componente, área propia y común.
model DjNivel {
  id                 Int      @id @default(autoincrement())
  anexoId            Int
  anexo              DjAnexo  @relation(fields: [anexoId], references: [id], onDelete: Restrict)
  orden              Int
  nivel              String   @db.VarChar(10) // piso, sótano, azotea…
  anioConstruccion   Int?
  mesConstruccion    Int?
  clasificacion      String   @db.VarChar(30) // catalogos-construccion.ts
  material           String   @db.VarChar(20)
  estadoConservacion String   @db.VarChar(20)
  categorias         String   @db.VarChar(7) // una letra por componente (REGEX_CATEGORIAS)
  areaPropia         Decimal  @db.Decimal(12, 2)
  areaComun          Decimal? @db.Decimal(12, 2)
  participacion      Decimal? @db.Decimal(6, 2) // V04: % de las áreas comunes
  createdAt          DateTime @default(now())

  @@index([anexoId])
  @@map("dj_niveles")
}

// Obras complementarias (V05): medidas y cantidad; el valor oficial se calcula al determinar.
model DjObra {
  id                 Int      @id @default(autoincrement())
  anexoId            Int
  anexo              DjAnexo  @relation(fields: [anexoId], references: [id], onDelete: Restrict)
  orden              Int
  codigo             String?  @db.VarChar(10) // V05: código de valores_obras (null = valor declarado)
  descripcion        String   @db.VarChar(120)
  unidad             String?  @db.VarChar(10)
  cantidad           Decimal  @db.Decimal(12, 2)
  largo              Decimal? @db.Decimal(10, 2)
  ancho              Decimal? @db.Decimal(10, 2)
  alto               Decimal? @db.Decimal(10, 2)
  anioConstruccion   Int?
  material           String?  @db.VarChar(20)
  estadoConservacion String?  @db.VarChar(20)
  valorDeclarado     Decimal? @db.Decimal(14, 2) // como en v1, mientras no haya tabla de valores (V05)
  createdAt          DateTime @default(now())

  @@index([anexoId])
  @@map("dj_obras")
}

// R03: varios usos por predio; los arbitrios se determinan por uso.
model DjUso {
  id            Int       @id @default(autoincrement())
  anexoId       Int
  anexo         DjAnexo   @relation(fields: [anexoId], references: [id], onDelete: Restrict)
  orden         Int
  uso           String    @db.VarChar(10) // catálogo USO_PREDIO
  subUso        String?   @db.VarChar(20) // catálogo SUB_USO_PREDIO (hijo del uso)
  inquilino     String?   @db.VarChar(120)
  area          Decimal   @db.Decimal(12, 2)
  frontis       Decimal?  @db.Decimal(10, 2)
  participacion Decimal?  @db.Decimal(6, 2)
  fechaInicio   DateTime? @db.Date
  fechaFin      DateTime? @db.Date
  predominante  Boolean   @default(false) // el manual marca uno
  createdAt     DateTime  @default(now())

  @@index([anexoId])
  @@map("dj_usos")
}

// V07: predio rústico, arancel por categoría y clasificación de tierras (el valor es del año).
model DjArancelRustico {
  id            Int      @id @default(autoincrement())
  anexoId       Int
  anexo         DjAnexo  @relation(fields: [anexoId], references: [id], onDelete: Restrict)
  orden         Int
  categoria     String   @db.VarChar(20)
  clasificacion String?  @db.VarChar(20)
  hectareas     Decimal  @db.Decimal(12, 4)
  createdAt     DateTime @default(now())

  @@index([anexoId])
  @@map("dj_aranceles_rusticos")
}

// J13: documentos adjuntos a la DJ.
model DjDocumento {
  id          Int          @id @default(autoincrement())
  djId        Int
  dj          DjPresentada @relation(fields: [djId], references: [id], onDelete: Restrict)
  orden       Int
  tipo        String       @db.VarChar(20) // catálogo TIPO_DOC_ADJUNTO
  numero      String?      @db.VarChar(40)
  fecha       DateTime?    @db.Date
  observacion String?      @db.VarChar(250)
  createdAt   DateTime     @default(now())

  @@index([djId])
  @@map("dj_documentos")
}

// J12: adquiriente (en un descargo) o transferente (en una adquisición). Como P10: los datos van
// aquí y, si el documento es de una persona registrada, se enlaza.
model DjAdquiriente {
  id                     Int            @id @default(autoincrement())
  anexoId                Int
  anexo                  DjAnexo        @relation(fields: [anexoId], references: [id], onDelete: Restrict)
  orden                  Int
  rol                    String         @db.VarChar(15) // ADQUIRIENTE | TRANSFERENTE
  tipoPersona            TipoPersona    @default(NATURAL)
  tipoDoc                String?        @db.VarChar(20)
  numDoc                 String?        @db.VarChar(20)
  nombreCompleto         String         @db.VarChar(120)
  direccion              String?        @db.VarChar(250)
  documentoTransferencia String?        @db.VarChar(20) // catálogo TIPO_DOC_TRANSFERENCIA
  personaId              Int?
  persona                Contribuyente? @relation("DjAdquirientePersona", fields: [personaId], references: [id], onDelete: SetNull)
  createdAt              DateTime       @default(now())

  @@index([anexoId])
  @@index([personaId])
  @@map("dj_adquirientes")
}

// J16 (Fase 7): prórroga del plazo de presentación de DJ (J08). General (sin persona, por ordenanza)
// o individual (solicitud que aprueba o rechaza un supervisor distinto de quien la registró).
enum EstadoProrroga {
  SOLICITADA
  APROBADA
  RECHAZADA
  ANULADA
}

model ProrrogaDj {
  id              Int            @id @default(autoincrement())
  contribuyenteId Int? // null = general, para todos
  contribuyente   Contribuyente? @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  anio            Int // año en que vence el plazo que se prorroga
  motivo          String?        @db.VarChar(20) // catálogo MOTIVO_DJ; null = todos los motivos con plazo
  fechaLimite     DateTime       @db.Date // nuevo vencimiento
  fechaSolicitud  DateTime       @db.Date
  sustento        String         @db.VarChar(250) // ordenanza, expediente o documento
  estado          EstadoProrroga @default(SOLICITADA)
  resueltaPorId   Int?
  resueltaPor     Usuario?       @relation("ProrrogaResueltaPor", fields: [resueltaPorId], references: [id], onDelete: Restrict)
  resueltaAt      DateTime?
  justificacion   String?        @db.VarChar(250)
  anuladaPorId    Int?
  anuladaPor      Usuario?       @relation("ProrrogaAnuladaPor", fields: [anuladaPorId], references: [id], onDelete: Restrict)
  anuladaAt       DateTime?
  anuladaMotivo   String?        @db.VarChar(250)
  createdAt       DateTime       @default(now())
  updatedAt       DateTime       @updatedAt
  creadoPorId     Int?
  creadoPor       Usuario?       @relation("ProrrogaCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId Int?
  modificadoPor   Usuario?       @relation("ProrrogaModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  @@index([anio, estado])
  @@index([contribuyenteId])
  @@map("prorrogas_dj")
}

// ============================================================
// DETERMINACIÓN (specs/rentas-nucleo-v2.md, Fase 5; reglas V01–V07, L01–L13, J10, J14, J15)
// Lo calculado: se regenera al determinar. Una por contribuyente y año (HR) con un PU/PR por predio
// y los arbitrios por predio × uso × mes. Al liquidar pasa a LIQUIDADA y la anterior del año queda
// REEMPLAZADA; lo que nunca se liquidó o se deshizo queda DESCARTADA (no se borra).
// ============================================================

enum EstadoDeterminacion {
  DETERMINADA
  LIQUIDADA
  REEMPLAZADA
  DESCARTADA
}

model Determinacion {
  id                Int                 @id @default(autoincrement())
  contribuyenteId   Int
  contribuyente     Contribuyente       @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  anio              Int
  djId              Int? // la DJ que la originó (la masiva de la Fase 6 no tiene)
  dj                DjPresentada?       @relation(fields: [djId], references: [id], onDelete: Restrict)
  estado            EstadoDeterminacion @default(DETERMINADA)
  baseImponible     Decimal             @db.Decimal(14, 2) // L01: suma de autoavalúos × % (con exoneraciones del predio)
  deduccion         Decimal             @default(0) @db.Decimal(14, 2) // P15
  baseAfecta        Decimal             @db.Decimal(14, 2)
  impuesto          Decimal             @db.Decimal(12, 2)
  derechoEmision    Decimal             @default(0) @db.Decimal(12, 2)
  arbitrios         Decimal             @default(0) @db.Decimal(12, 2)
  predialCalculable Boolean             @default(true) // false = algún predio sin valorizar (V06)
  liquidaPredial    Boolean             @default(false) // L08: qué generó cuenta al liquidar
  liquidaArbitrios  Boolean             @default(false)
  detalle           Json // cuotas, beneficios aplicados, errores, avisos, huella y cuotas anuladas (L10)
  liquidadaAt       DateTime?
  createdAt         DateTime            @default(now())
  updatedAt         DateTime            @updatedAt
  creadoPorId       Int?
  creadoPor         Usuario?            @relation("DeterminacionCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId   Int?
  modificadoPor     Usuario?            @relation("DeterminacionModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  predios      DeterminacionPredio[]
  arbitriosMes DeterminacionArbitrio[]
  cuentas      CuentaCorriente[]

  @@index([contribuyenteId, anio])
  @@index([djId])
  @@index([estado])
  @@map("determinaciones")
}

// PU (urbano) / PR (rústico): autoavalúo del predio en el año y lo declarado que se usó (`datos`),
// para reconstruir el predio de ese año sin copias por año.
model DeterminacionPredio {
  id              Int           @id @default(autoincrement())
  determinacionId Int
  determinacion   Determinacion @relation(fields: [determinacionId], references: [id], onDelete: Restrict)
  predioId        Int
  predio          Predio        @relation(fields: [predioId], references: [id], onDelete: Restrict)
  tipo            TipoPredio
  origen          String        @db.VarChar(60) // "DJ 26-0000003 · anexo 1", "Determinación 2025", "Padrón"
  condicion       String?       @db.VarChar(20) // R05
  porcentaje      Decimal       @db.Decimal(6, 2)
  afectoPredial   Boolean // J10: era contribuyente al 1 de enero
  exoneracion     Decimal       @default(0) @db.Decimal(5, 2) // R06: % de inafectación o exoneración
  terreno         Decimal?      @db.Decimal(14, 2)
  construccion    Decimal?      @db.Decimal(14, 2)
  obras           Decimal?      @db.Decimal(14, 2)
  autoavaluo      Decimal?      @db.Decimal(14, 2) // null = no se pudo valorizar (error)
  valorAfecto     Decimal       @default(0) @db.Decimal(14, 2) // autoavalúo × % × (1 − exoneración)
  arbitrios       Decimal       @default(0) @db.Decimal(12, 2)
  error           String?       @db.VarChar(250)
  datos           Json
  createdAt       DateTime      @default(now())

  @@index([determinacionId])
  @@index([predioId])
  @@map("determinacion_predios")
}

// L07: arbitrios por predio × uso × mes × concepto (4 decimales: las cuotas se redondean al agrupar).
model DeterminacionArbitrio {
  id              Int           @id @default(autoincrement())
  determinacionId Int
  determinacion   Determinacion @relation(fields: [determinacionId], references: [id], onDelete: Restrict)
  predioId        Int
  predio          Predio        @relation(fields: [predioId], references: [id], onDelete: Restrict)
  uso             String        @db.VarChar(10)
  mes             Int
  concepto        String        @db.VarChar(30)
  importe         Decimal       @db.Decimal(12, 4)

  @@index([determinacionId])
  @@map("determinacion_arbitrios")
}

// Declaración jurada versionada (reemplaza declaracion_j y copias a_*/f_*/h_* de SIMUN)
model DeclaracionJurada {
  id              Int               @id @default(autoincrement())
  predioId        Int
  predio          Predio            @relation(fields: [predioId], references: [id], onDelete: Restrict)
  contribuyenteId Int
  contribuyente   Contribuyente     @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  anio            Int
  motivo          MotivoDeclaracion
  fecha           DateTime          @db.Date
  fechaHecho      DateTime?         @db.Date // adquisición o inscripción: inicia el plazo de la DJ (D.L. 776 art. 14)
  multaDescartada String?           @db.VarChar(200) // DJ extemporánea sin multa 176.1: motivo (specs/rentas-fiscalizacion-v1.md, F7)
  snapshot        Json // predio + pisos + condóminos al momento de la DJ
  observacion     String?           @db.VarChar(250)
  createdAt       DateTime          @default(now())
  updatedAt       DateTime          @updatedAt
  creadoPorId     Int?
  creadoPor       Usuario?          @relation("DeclaracionCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId Int?
  modificadoPor   Usuario?          @relation("DeclaracionModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  multas              ValorCab[]
  fiscalizacionPredio FiscalizacionPredio[]

  @@index([predioId, anio])
  @@index([contribuyenteId, anio])
  @@map("declaraciones_juradas")
}

// Catálogos de Rentas v2 (specs/rentas-nucleo-v2.md, §3 y Fase 0; reglas en docs/rentas/reglas-negocio.md).
// Una sola tabla con grupo: cada muni edita nombres, orden, atributos y activo en su base.
// El código no cambia nunca (otros registros lo guardan como texto). `sistema` = el código
// del sistema depende de esa fila: se puede renombrar, no desactivar.
// Los atributos por grupo los valida backend/src/catalogos/catalogos.reglas.ts.
enum GrupoCatalogo {
  TIPO_DOCUMENTO
  TIPO_CONTACTO
  TIPO_RELACIONADO
  TIPO_SUCESION
  PERFIL_CUMPLIMIENTO
  PERFIL_COBRANZA
  CLASIFICACION_CONTRIBUYENTE
  BENEFICIO
  COMPONENTE_DIRECCION
  TIPO_VIA
  TIPO_HABILITACION
  FRECUENCIA_BARRIDO
  UBICACION_PARQUE
  CONDICION_PROPIEDAD
  USO_PREDIO
  SUB_USO_PREDIO
  MOTIVO_DJ
  SUB_MOTIVO_DJ
  TIPO_DOC_ADJUNTO
  TIPO_DOC_TRANSFERENCIA
}

model Catalogo {
  id          Int           @id @default(autoincrement())
  grupo       GrupoCatalogo
  codigo      String        @db.VarChar(20)
  nombre      String        @db.VarChar(120)
  abreviatura String?       @db.VarChar(20)
  padreId     Int? // SUB_USO_PREDIO → USO_PREDIO; SUB_MOTIVO_DJ → MOTIVO_DJ
  padre       Catalogo?     @relation("CatalogoJerarquia", fields: [padreId], references: [id], onDelete: Restrict)
  hijos       Catalogo[]    @relation("CatalogoJerarquia")
  atributos   Json? // propios del grupo (p. ej. MOTIVO_DJ.tipo = INFORMATIVA | DECLARATIVA)
  orden       Int           @default(0)
  activo      Boolean       @default(true)
  sistema     Boolean       @default(false)
  ordenanza   String?       @db.VarChar(60)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt

  @@unique([grupo, codigo])
  @@index([grupo, orden])
  @@index([padreId])
  @@map("catalogos")
}

// Reglas "Parám." que no son un catálogo (J05, J11, J16 y cuotas de arbitrios): clave/valor por base.
model ReglaMuni {
  clave       String   @id @db.VarChar(60)
  valor       Json
  descripcion String   @db.VarChar(250)
  regla       String?  @db.VarChar(20) // ID en docs/rentas/reglas-negocio.md
  ordenanza   String?  @db.VarChar(60)
  createdAt   DateTime @default(now())
  updatedAt   DateTime @updatedAt

  @@map("reglas_muni")
}

model Tupa {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique @db.VarChar(20)
  glosa     String   @db.VarChar(200)
  tasa      Decimal  @db.Decimal(10, 2) // soles
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("tupa")
}

// ============================================================
// F. CUENTA CORRIENTE, CAJA Y CONVENIOS
// Ref SIMUN: cta_aica.dbf (1.9M) + pagos.DBF (1M) +
//   convenios_contri + convenios_detalle.DBF
// Regla: Pago y ConvenioDet siempre referencian CuentaCorriente
// para no perder trazabilidad deuda -> pago.
// ============================================================

model CuentaCorriente {
  id               Int              @id @default(autoincrement())
  contribuyenteId  Int
  contribuyente    Contribuyente    @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  predioId         Int?
  predio           Predio?          @relation(fields: [predioId], references: [id], onDelete: Restrict)
  vehiculoId       Int?
  vehiculo         Vehiculo?        @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  tributoId        Int
  tributo          Tributo          @relation(fields: [tributoId], references: [id], onDelete: Restrict)
  anioFiscal       Int
  cuota            Int              @default(0) // 0 = anual, 1-4 trimestral, 1-12 mensual
  importe          Decimal          @db.Decimal(12, 2)
  descuento        Decimal          @default(0) @db.Decimal(12, 2)
  reajuste         Decimal          @default(0) @db.Decimal(12, 2)
  mora             Decimal          @default(0) @db.Decimal(12, 2)
  derechoEmision   Decimal          @default(0) @db.Decimal(12, 2)
  fechaVencimiento DateTime?        @db.Date
  estado           EstadoCuenta     @default(PENDIENTE)
  // Diferencia de fiscalización sobre una cuota protegida (specs/rentas-fiscalizacion-v1.md, decisión 3)
  ajusteDeId       Int?
  ajusteDe         CuentaCorriente? @relation("AjusteCuenta", fields: [ajusteDeId], references: [id], onDelete: Restrict)
  // Determinación v2 que la generó (specs/rentas-nucleo-v2.md, Fase 5); null = cálculo v1 u otro origen.
  determinacionId  Int?
  determinacion    Determinacion?   @relation(fields: [determinacionId], references: [id], onDelete: Restrict)
  createdAt        DateTime         @default(now())
  updatedAt        DateTime         @updatedAt
  creadoPorId      Int?
  creadoPor        Usuario?         @relation("CuentaCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId  Int?
  modificadoPor    Usuario?         @relation("CuentaModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  pagos            Pago[]
  convenioDetalles ConvenioDet[]
  convenioDeudas   ConvenioDeuda[]   @relation("ConvenioDeudaOrigen")
  valorDetalles    ValorDet[]
  coactivoDetalles CoactivoDet[]
  ajustes          CuentaCorriente[] @relation("AjusteCuenta")

  @@index([contribuyenteId, anioFiscal])
  @@index([ajusteDeId])
  @@index([determinacionId])
  @@index([predioId, anioFiscal])
  @@index([tributoId, anioFiscal])
  @@index([estado])
  @@map("cuenta_corriente")
}

// Caja (specs/caja-v1.md, decisión 1). Ref SIMUN: pagos.dbf (una fila por cuota, NROMOV agrupa),
// recibos.dbf y cierre_de_caja.dbf.
// Un cobro en ventanilla de un contribuyente: N cuotas, un medio de pago, un número correlativo.
model Recibo {
  id               Int           @id @default(autoincrement())
  anio             Int
  numero           String        @db.VarChar(15) // REC 2026-000001
  contribuyenteId  Int
  contribuyente    Contribuyente @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  cajeroId         Int
  cajero           Usuario       @relation("CajeroRecibos", fields: [cajeroId], references: [id], onDelete: Restrict)
  fecha            DateTime      @default(now()) @db.Timestamptz(6)
  fechaCaja        DateTime      @db.Date // día de caja (hora Lima) al que pertenece el cobro
  total            Decimal       @db.Decimal(12, 2)
  medioPago        MedioPago     @default(EFECTIVO)
  numOperacion     String?       @db.VarChar(30) // voucher / transferencia / depósito
  estado           EstadoCuenta  @default(CANCELADO) // CANCELADO | EXTORNADO
  motivoExtorno    String?       @db.VarChar(200)
  extornadoPorId   Int?
  extornadoPor     Usuario?      @relation("ReciboExtornadoPor", fields: [extornadoPorId], references: [id], onDelete: Restrict)
  fechaExtorno     DateTime?     @db.Timestamptz(6)
  fechaCajaExtorno DateTime?     @db.Date // el extorno cuenta en el día de caja en que se hace (decisión 7)
  cierreId         Int?
  cierre           CierreCaja?   @relation(fields: [cierreId], references: [id], onDelete: Restrict)
  createdAt        DateTime      @default(now())

  pagos Pago[]

  @@unique([anio, numero])
  @@index([cajeroId, fechaCaja])
  @@index([extornadoPorId, fechaCajaExtorno])
  @@index([contribuyenteId])
  @@index([fechaCaja])
  @@map("recibos")
}

// Detalle del recibo: una fila por cuota cobrada, con la liquidación a la fecha del cobro.
model Pago {
  id                Int             @id @default(autoincrement())
  reciboId          Int
  recibo            Recibo          @relation(fields: [reciboId], references: [id], onDelete: Restrict)
  cuentaCorrienteId Int
  cuentaCorriente   CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id], onDelete: Restrict)
  contribuyenteId   Int
  contribuyente     Contribuyente   @relation("PagadorContribuyente", fields: [contribuyenteId], references: [id], onDelete: Restrict)
  fechaPago         DateTime        @default(now()) @db.Timestamptz(6)
  importe           Decimal         @db.Decimal(12, 2) // insoluto
  reajuste          Decimal         @default(0) @db.Decimal(12, 2)
  moraPagada        Decimal         @default(0) @db.Decimal(12, 2)
  derechoEmision    Decimal         @default(0) @db.Decimal(12, 2)
  subtotal          Decimal         @db.Decimal(12, 2)
  estadoAnterior    EstadoCuenta // estado de la cuota antes del cobro: el extorno la devuelve ahí
  estado            EstadoCuenta    @default(CANCELADO) // CANCELADO | EXTORNADO
  createdAt         DateTime        @default(now())
  modificadoPorId   Int? // lo fija el trigger auditoria_autor
  modificadoPor     Usuario?        @relation("PagoModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  @@index([reciboId])
  @@index([cuentaCorrienteId])
  @@index([contribuyenteId])
  @@index([fechaPago])
  @@map("pagos")
}

// Cierre diario por cajero: foto inmutable de lo cobrado y extornado ese día de caja.
model CierreCaja {
  id                Int      @id @default(autoincrement())
  cajeroId          Int
  cajero            Usuario  @relation(fields: [cajeroId], references: [id], onDelete: Restrict)
  fecha             DateTime @db.Date
  cantidadRecibos   Int
  cantidadExtornos  Int
  total             Decimal  @db.Decimal(12, 2) // cobrado − extornado en el día
  totalesPorMedio   Json // { EFECTIVO: "120.00", ... }
  totalesPorTributo Json // [{ codigo, nombre, total }]
  efectivoDeclarado Decimal? @db.Decimal(12, 2) // arqueo opcional
  diferencia        Decimal? @db.Decimal(12, 2) // declarado − efectivo esperado (+ sobrante / − faltante)
  createdAt         DateTime @default(now()) @db.Timestamptz(6)

  recibos Recibo[]

  @@unique([cajeroId, fecha])
  @@map("cierres_caja")
}

model ConvenioCab {
  id              Int           @id @default(autoincrement())
  numero          String        @unique @db.VarChar(20) // NROFRA SIMUN
  contribuyenteId Int
  contribuyente   Contribuyente @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  fecha           DateTime      @default(now()) @db.Date
  montoTotal      Decimal       @db.Decimal(12, 2)
  cuotaInicial    Decimal       @default(0) @db.Decimal(12, 2)
  numCuotas       Int
  interesMensual  Decimal       @default(0) @db.Decimal(7, 4)
  motivoAnulacion String?       @db.VarChar(200)
  estado          EstadoCuenta  @default(FRACCIONADO)
  creadoPorId     Int?
  creadoPor       Usuario?      @relation("CreadorConvenio", fields: [creadoPorId], references: [id], onDelete: SetNull)
  modificadoPorId Int?
  modificadoPor   Usuario?      @relation("ConvenioModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  createdAt       DateTime      @default(now())

  detalles ConvenioDet[] // cronograma
  deudas   ConvenioDeuda[]

  @@index([contribuyenteId])
  @@map("convenios")
}

// Cronograma: cada cuota del convenio es una fila nueva en cuenta_corriente (tributo FRACCION)
model ConvenioDet {
  id                Int             @id @default(autoincrement())
  convenioId        Int
  convenio          ConvenioCab     @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  cuentaCorrienteId Int
  cuentaCorriente   CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id], onDelete: Restrict)
  cuotaNumero       Int // 0 = cuota inicial
  amortizacion      Decimal         @default(0) @db.Decimal(12, 2)
  interes           Decimal         @default(0) @db.Decimal(12, 2)
  monto             Decimal         @db.Decimal(12, 2)
  fechaVencimiento  DateTime        @db.Date
  estado            EstadoCuenta    @default(PENDIENTE)

  @@unique([convenioId, cuotaNumero])
  @@index([cuentaCorrienteId])
  @@map("convenio_detalle")
}

// Deudas originales incluidas en el convenio (pasan a FRACCIONADO), con su liquidación a la fecha
model ConvenioDeuda {
  id                Int             @id @default(autoincrement())
  convenioId        Int
  convenio          ConvenioCab     @relation(fields: [convenioId], references: [id], onDelete: Restrict)
  cuentaCorrienteId Int
  cuentaCorriente   CuentaCorriente @relation("ConvenioDeudaOrigen", fields: [cuentaCorrienteId], references: [id], onDelete: Restrict)
  insoluto          Decimal         @db.Decimal(12, 2)
  reajuste          Decimal         @default(0) @db.Decimal(12, 2)
  mora              Decimal         @default(0) @db.Decimal(12, 2)
  subtotal          Decimal         @db.Decimal(12, 2)

  @@unique([convenioId, cuentaCorrienteId])
  @@index([cuentaCorrienteId])
  @@map("convenio_deudas")
}

// ============================================================
// G. COBRANZA ORDINARIA (OP/RD) Y COACTIVA
// Ref SIMUN: valores_cobranza_cab/det + coactivo_cab/det +
//   tabla_ejecutor_coactivo + tabla_auxiliares_coactivo
// ============================================================

model ValorCab {
  id                    Int                    @id @default(autoincrement())
  tipo                  TipoValor
  anio                  Int
  numero                String                 @db.VarChar(15) // NUM_VAL
  contribuyenteId       Int
  contribuyente         Contribuyente          @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  predioId              Int?
  predio                Predio?                @relation(fields: [predioId], references: [id], onDelete: Restrict)
  baseImponible         Decimal?               @db.Decimal(12, 2)
  totalDeuda            Decimal                @db.Decimal(12, 2)
  fechaEmision          DateTime               @default(now()) @db.Date
  fechaNotificacion     DateTime?              @db.Date
  modalidadNotificacion ModalidadNotificacion?
  notificadoDni         String?                @db.VarChar(15)
  notificadoNombre      String?                @db.VarChar(100)
  fechaExigible         DateTime?              @db.Date
  motivoAnulacion       String?                @db.VarChar(200)
  transferenciaId       Int?
  transferencia         TransferenciaCoactivo? @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)
  // Origen fiscalización (RD por diferencias y RM): specs/rentas-fiscalizacion-v1.md, decisiones 4-6
  fiscalizacionId       Int?
  fiscalizacion         Fiscalizacion?         @relation(fields: [fiscalizacionId], references: [id], onDelete: Restrict)
  infraccionId          Int? // solo RM
  infraccion            Infraccion?            @relation(fields: [infraccionId], references: [id], onDelete: Restrict)
  declaracionId         Int? // RM por DJ extemporánea (F7)
  declaracion           DeclaracionJurada?     @relation(fields: [declaracionId], references: [id], onDelete: Restrict)
  djPresentadaId        Int? // RM por DJ v2 fuera de plazo (J08)
  djPresentada          DjPresentada?          @relation(fields: [djPresentadaId], references: [id], onDelete: Restrict)
  // Cobranza coactiva: memo que origina la transferencia y auxiliar que recibe el valor
  memorandumId          Int?
  memorandum            MemorandumCoactiva?    @relation(fields: [memorandumId], references: [id])
  auxiliarAsignadoId    Int?
  auxiliarAsignado      AuxiliarCoactivo?      @relation(fields: [auxiliarAsignadoId], references: [id])
  estado                EstadoValor            @default(EMITIDO)
  createdAt             DateTime               @default(now())
  creadoPorId           Int?
  creadoPor             Usuario?               @relation("ValorCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId       Int?
  modificadoPor         Usuario?               @relation("ValorModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  detalles    ValorDet[]
  expedientes CoactivoExp[]

  @@unique([tipo, anio, numero])
  @@index([contribuyenteId])
  @@index([estado])
  @@index([fiscalizacionId])
  @@index([memorandumId])
  @@index([auxiliarAsignadoId])
  @@map("valores_cab")
}

// ============================================================
// Fiscalización tributaria (specs/rentas-fiscalizacion-v1.md, decisiones 1, 2 y 5)
// Ref SIMUN: requerimiento.dbf + Fichas_Fiscalizacion.dbf + tabla_tecnico_fisca.dbf +
//   INFRACCIONES_MULTATRIBUTARIA.dbf + Multas_tributarias.dbf
// ============================================================

// Inspectores de campo: no siempre son usuarios del sistema (usuarioId opcional).
model Fiscalizador {
  id        Int      @id @default(autoincrement())
  nombre    String   @db.VarChar(100)
  dni       String   @unique @db.VarChar(15)
  activo    Boolean  @default(true)
  usuarioId Int?     @unique
  usuario   Usuario? @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  createdAt DateTime @default(now())

  fiscalizaciones Fiscalizacion[]

  @@map("fiscalizadores")
}

model Fiscalizacion {
  id                    Int                    @id @default(autoincrement())
  anio                  Int
  numero                String                 @db.VarChar(15) // FIS 2026-000001
  tipo                  TipoFiscalizacion
  contribuyenteId       Int
  contribuyente         Contribuyente          @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  fiscalizadorId        Int
  fiscalizador          Fiscalizador           @relation(fields: [fiscalizadorId], references: [id], onDelete: Restrict)
  anioDesde             Int
  anioHasta             Int
  estado                EstadoFiscalizacion    @default(ABIERTO)
  fechaInspeccion       DateTime?              @db.Timestamptz(6) // fecha y hora de la visita (requerimiento)
  fechaNotificacion     DateTime?              @db.Date
  modalidadNotificacion ModalidadNotificacion?
  notificadoDni         String?                @db.VarChar(15)
  notificadoNombre      String?                @db.VarChar(100)
  observacion           String?                @db.VarChar(500)
  motivoAnulacion       String?                @db.VarChar(200)
  createdAt             DateTime               @default(now())
  updatedAt             DateTime               @updatedAt
  creadoPorId           Int?
  creadoPor             Usuario?               @relation("FiscalizacionCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId       Int?
  modificadoPor         Usuario?               @relation("FiscalizacionModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  predios FiscalizacionPredio[]
  valores ValorCab[]

  @@unique([anio, numero])
  @@index([contribuyenteId])
  @@index([estado])
  @@map("fiscalizaciones")
}

// Un predio del expediente: lo verificado en la inspección (ficha) y su liquidación contra lo declarado.
model FiscalizacionPredio {
  id              Int                @id @default(autoincrement())
  fiscalizacionId Int
  fiscalizacion   Fiscalizacion      @relation(fields: [fiscalizacionId], references: [id], onDelete: Restrict)
  predioId        Int
  predio          Predio             @relation(fields: [predioId], references: [id], onDelete: Restrict)
  ficha           Json? // mismos datos que la DJ: terreno, pisos, instalaciones, uso, zona
  liquidacion     Json? // por año y tributo: declarado, fiscalizado, diferencia (al resolver)
  declaracionId   Int? // DJ de motivo FISCALIZACION con la que se aplicó la ficha al predio
  declaracion     DeclaracionJurada? @relation(fields: [declaracionId], references: [id], onDelete: Restrict)
  createdAt       DateTime           @default(now())
  updatedAt       DateTime           @updatedAt

  @@unique([fiscalizacionId, predioId])
  @@index([predioId])
  @@map("fiscalizacion_predios")
}

// Infracciones y sanciones por año (Código Tributario arts. 176 y 178, tablas de infracciones).
model Infraccion {
  id                 Int       @id @default(autoincrement())
  anio               Int
  codigo             String    @db.VarChar(10) // 176.1, 176.2, 178.1
  articulo           String    @db.VarChar(5)
  numeral            String    @db.VarChar(5)
  descripcion        String    @db.VarChar(250)
  base               BaseMulta
  porcentajeNatural  Decimal   @db.Decimal(7, 2) // persona natural y sucesión
  porcentajeJuridica Decimal   @db.Decimal(7, 2)
  ordenanza          String?   @db.VarChar(60)
  createdAt          DateTime  @default(now())

  valores ValorCab[]

  @@unique([anio, codigo])
  @@map("infracciones")
}

// Memorándum de transferencia de valores exigibles a Cobranza Coactiva (SIMUN: memo_coactivo)
model TransferenciaCoactivo {
  id        Int                 @id @default(autoincrement())
  anio      Int
  numero    String              @db.VarChar(15)
  fecha     DateTime            @default(now()) @db.Date
  cantidad  Int
  monto     Decimal             @db.Decimal(12, 2)
  estado    EstadoTransferencia @default(ENVIADA)
  createdAt DateTime            @default(now())

  valores ValorCab[]

  @@unique([anio, numero])
  @@map("transferencias_coactivo")
}

model ValorDet {
  id                Int             @id @default(autoincrement())
  valorId           Int
  valor             ValorCab        @relation(fields: [valorId], references: [id], onDelete: Cascade)
  cuentaCorrienteId Int
  cuentaCorriente   CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id], onDelete: Restrict)
  importe           Decimal         @db.Decimal(12, 2)
  mora              Decimal         @default(0) @db.Decimal(12, 2)
  reajuste          Decimal         @default(0) @db.Decimal(12, 2)
  subtotal          Decimal         @db.Decimal(12, 2)

  @@index([cuentaCorrienteId])
  @@map("valores_det")
}

model CoactivoExp {
  id              Int               @id @default(autoincrement())
  anioExpediente  Int
  numExpediente   String            @db.VarChar(15)
  valorId         Int?
  valor           ValorCab?         @relation(fields: [valorId], references: [id], onDelete: SetNull)
  contribuyenteId Int
  contribuyente   Contribuyente     @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  ejecutorId      Int?
  ejecutor        EjecutorCoactivo? @relation(fields: [ejecutorId], references: [id])
  auxiliarId      Int?
  auxiliar        AuxiliarCoactivo? @relation(fields: [auxiliarId], references: [id])
  tipoGestionId   Int? // sin FK: la BD no la tiene (la rama tampoco la declara)
  estado          EstadoValor       @default(EMITIDO)
  fechaGeneracion DateTime          @default(now()) @db.Date
  createdAt       DateTime          @default(now())
  creadoPorId     Int?
  creadoPor       Usuario?          @relation("ExpedienteCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId Int?
  modificadoPor   Usuario?          @relation("ExpedienteModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  detalles CoactivoDet[]

  @@unique([anioExpediente, numExpediente])
  @@index([contribuyenteId])
  @@index([ejecutorId])
  @@index([auxiliarId])
  @@map("coactivo_exp")
}

model CoactivoDet {
  id                Int              @id @default(autoincrement())
  expedienteId      Int
  expediente        CoactivoExp      @relation(fields: [expedienteId], references: [id], onDelete: Cascade)
  cuentaCorrienteId Int?
  cuentaCorriente   CuentaCorriente? @relation(fields: [cuentaCorrienteId], references: [id], onDelete: Restrict)
  descripcion       String           @db.VarChar(150)
  monto             Decimal          @db.Decimal(12, 2)

  @@index([expedienteId])
  @@map("coactivo_det")
}

// ============================================================
// G2. MAESTROS DE COBRANZA COACTIVA
// specs/coactiva-recepcion-transferencia-v1.md
// Ref SIMUN: tabla_ejecutor_coactivo + tabla_auxiliares_coactivo + memo_coactivo
// ============================================================

// Ejecutor que ordena la transferencia (antes texto libre en coactivo_exp.ejecutor)
model EjecutorCoactivo {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique @db.VarChar(10)
  nombre      String        @db.VarChar(100)
  activo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  coactivoExp CoactivoExp[]

  @@map("ejecutores_coactivo")
}

// Auxiliar que acompaña el expediente y al que se le asignan valores
model AuxiliarCoactivo {
  id          Int           @id @default(autoincrement())
  codigo      String        @unique @db.VarChar(10)
  nombre      String        @db.VarChar(100)
  activo      Boolean       @default(true)
  createdAt   DateTime      @default(now())
  updatedAt   DateTime      @updatedAt
  coactivoExp CoactivoExp[]
  valores     ValorCab[]

  @@map("auxiliares_coactivo")
}

// Memorándum de recepción: origen de la transferencia de valores a coactiva
model MemorandumCoactiva {
  id             Int        @id @default(autoincrement())
  numero         String     @unique @db.VarChar(20)
  anio           Int
  areaOrigen     String     @db.VarChar(100)
  fechaRecepcion DateTime   @db.Date
  activo         Boolean    @default(true)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  valores        ValorCab[]

  @@index([anio])
  @@map("memorandums_coactiva")
}

// Tipo de gestión del expediente. Sin FK en coactivo_exp.tipoGestionId: la BD no la tiene.
model TipoGestionCoactiva {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique @db.VarChar(10)
  descripcion String    @db.VarChar(150)
  activo      Boolean?  @default(true)
  createdAt   DateTime? @default(now())

  @@map("tipos_gestion_coactiva")
}

// ============================================================
// H. LICENCIAS DE FUNCIONAMIENTO
// Ref SIMUN: licencias.dbf + giros.dbf + clases/tipos de licencias
// ============================================================

model GiroNegocio {
  id          Int     @id @default(autoincrement())
  codigo      String  @unique @db.VarChar(10)
  descripcion String  @db.VarChar(150)
  activo      Boolean @default(true)

  licencias Licencia[]

  @@map("giros_negocio")
}

model Licencia {
  id               Int            @id @default(autoincrement())
  numeroLicencia   String         @unique @db.VarChar(20) // NROLIC SIMUN
  contribuyenteId  Int
  contribuyente    Contribuyente  @relation(fields: [contribuyenteId], references: [id], onDelete: Restrict)
  predioId         Int?
  predio           Predio?        @relation(fields: [predioId], references: [id], onDelete: Restrict)
  giroId           Int?
  giro             GiroNegocio?   @relation(fields: [giroId], references: [id], onDelete: Restrict)
  direccionLocal   String?        @db.VarChar(150) // DIRLIC
  area             Decimal?       @db.Decimal(10, 2)
  horario          String?        @db.VarChar(100)
  fechaEmision     DateTime       @default(now()) @db.Date
  fechaVencimiento DateTime?      @db.Date
  estado           EstadoLicencia @default(VIGENTE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creadoPorId      Int?
  creadoPor        Usuario?       @relation("LicenciaCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPorId  Int?
  modificadoPor    Usuario?       @relation("LicenciaModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  @@index([contribuyenteId])
  @@index([estado])
  @@map("licencias")
}

// ============================================================
// IA — Chat San Bartolo (specs/ia-chat-v1.md)
// ============================================================

enum RolMensajeChat {
  USER
  IA
}

// Guía de docs/ia/*.md ingerida (re-ingesta por hash).
model IaDocumento {
  id            Int           @id @default(autoincrement())
  archivo       String        @unique @db.VarChar(150)
  titulo        String        @db.VarChar(200)
  hash          String        @db.VarChar(64)
  actualizadoEn DateTime      @default(now()) @updatedAt
  fragmentos    IaFragmento[]

  @@map("ia_documento")
}

// Fragmento de una guía con su embedding (lectura/escritura vía $queryRaw).
model IaFragmento {
  id          Int                         @id @default(autoincrement())
  documentoId Int
  documento   IaDocumento                 @relation(fields: [documentoId], references: [id], onDelete: Cascade)
  titulo      String                      @db.VarChar(200)
  seccion     String                      @db.VarChar(200)
  posicion    Int
  contenido   String
  embedding   Unsupported("vector(768)")?

  @@index([documentoId])
  @@map("ia_fragmento")
}

model ChatConversacion {
  id              Int           @id @default(autoincrement())
  usuarioId       Int
  usuario         Usuario       @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
  titulo          String        @db.VarChar(120)
  creadoEn        DateTime      @default(now())
  ultimoMensajeEn DateTime      @default(now())
  mensajes        ChatMensaje[]

  @@index([usuarioId, ultimoMensajeEn])
  @@map("chat_conversacion")
}

model ChatMensaje {
  id             Int              @id @default(autoincrement())
  conversacionId Int
  conversacion   ChatConversacion @relation(fields: [conversacionId], references: [id], onDelete: Restrict)
  rol            RolMensajeChat
  contenido      String
  fragmentosJson Json?
  tokens         Int?
  createdAt      DateTime         @default(now())

  @@index([conversacionId, createdAt])
  @@map("chat_mensaje")
}

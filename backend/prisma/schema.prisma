generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DIRECT_URL")
}

model Oficina {
  id              Int       @id @default(autoincrement())
  codigo          String    @unique @db.VarChar(10)
  nombre          String    @db.VarChar(100)
  activo          Boolean   @default(true)
  createdAt       DateTime  @default(now())
  updatedAt       DateTime  @updatedAt
  creadoPorId     Int?
  modificadoPorId Int?
  creadoPor       Usuario?  @relation("OficinaCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPor   Usuario?  @relation("OficinaModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  usuarios        Usuario[]

  @@map("oficinas")
}

model Rol {
  id              Int        @id @default(autoincrement())
  nombre          String     @unique @db.VarChar(50)
  descripcion     String?    @db.VarChar(200)
  createdAt       DateTime   @default(now())
  updatedAt       DateTime   @updatedAt
  activo          Boolean    @default(true)
  creadoPorId     Int?
  modificadoPorId Int?
  accesos         RolNivel[]
  creadoPor       Usuario?   @relation("RolCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPor   Usuario?   @relation("RolModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  usuarios        Usuario[]

  @@map("roles")
}

model Nivel {
  id             Int        @id @default(autoincrement())
  codigo         String     @unique @db.VarChar(100)
  tipo           TipoNivel
  nombre         String     @db.VarChar(100)
  descripcion    String?    @db.VarChar(200)
  padreId        Int?
  orden          Int        @default(0)
  createdAt      DateTime   @default(now())
  updatedAt      DateTime   @updatedAt
  padre          Nivel?     @relation("NivelJerarquia", fields: [padreId], references: [id], onDelete: Restrict)
  hijos          Nivel[]    @relation("NivelJerarquia")
  rolesAsignados RolNivel[]

  @@index([padreId])
  @@map("niveles")
}

model RolNivel {
  rolId     Int
  nivelId   Int
  createdAt DateTime @default(now())
  updatedAt DateTime @updatedAt
  nivel     Nivel    @relation(fields: [nivelId], references: [id])
  rol       Rol      @relation(fields: [rolId], references: [id], onDelete: Cascade)

  @@id([rolId, nivelId])
  @@map("rol_nivel")
}

model Usuario {
  id                                                        Int                 @id @default(autoincrement())
  usuario                                                   String              @unique @db.VarChar(50)
  password                                                  String              @db.VarChar(255)
  activo                                                    Boolean             @default(true)
  oficinaId                                                 Int?
  createdAt                                                 DateTime            @default(now())
  updatedAt                                                 DateTime            @updatedAt
  nombres                                                   String              @db.VarChar(100)
  apellidos                                                 String              @db.VarChar(100)
  rolId                                                     Int
  creadoPorId                                               Int?
  modificadoPorId                                           Int?
  auditorias                                                Auditoria[]
  cierres_caja                                              cierres_caja[]
  expedientesCreados                                        CoactivoExp[]       @relation("ExpedienteCreadoPor")
  expedientesModificados                                    CoactivoExp[]       @relation("ExpedienteModificadoPor")
  contribuyentesCreados                                     Contribuyente[]     @relation("ContribuyenteCreadoPor")
  contribuyentesModificados                                 Contribuyente[]     @relation("ContribuyenteModificadoPor")
  conveniosCreados                                          ConvenioCab[]       @relation("CreadorConvenio")
  conveniosModificados                                      ConvenioCab[]       @relation("ConvenioModificadoPor")
  cuentasCreadas                                            CuentaCorriente[]   @relation("CuentaCreadoPor")
  cuentasModificadas                                        CuentaCorriente[]   @relation("CuentaModificadoPor")
  declaracionesCreadas                                      DeclaracionJurada[] @relation("DeclaracionCreadoPor")
  declaracionesModificadas                                  DeclaracionJurada[] @relation("DeclaracionModificadoPor")
  fiscalizaciones_fiscalizaciones_creadoPorIdTousuarios     fiscalizaciones[]   @relation("fiscalizaciones_creadoPorIdTousuarios")
  fiscalizaciones_fiscalizaciones_modificadoPorIdTousuarios fiscalizaciones[]   @relation("fiscalizaciones_modificadoPorIdTousuarios")
  fiscalizadores                                            fiscalizadores?
  licenciasCreadas                                          Licencia[]          @relation("LicenciaCreadoPor")
  licenciasModificadas                                      Licencia[]          @relation("LicenciaModificadoPor")
  oficinasCreadas                                           Oficina[]           @relation("OficinaCreadoPor")
  oficinasModificadas                                       Oficina[]           @relation("OficinaModificadoPor")
  pagosModificados                                          Pago[]              @relation("PagoModificadoPor")
  prediosCreados                                            Predio[]            @relation("PredioCreadoPor")
  prediosModificados                                        Predio[]            @relation("PredioModificadoPor")
  recibos_recibos_cajeroIdTousuarios                        recibos[]           @relation("recibos_cajeroIdTousuarios")
  recibos_recibos_extornadoPorIdTousuarios                  recibos[]           @relation("recibos_extornadoPorIdTousuarios")
  rolesCreados                                              Rol[]               @relation("RolCreadoPor")
  rolesModificados                                          Rol[]               @relation("RolModificadoPor")
  creadoPor                                                 Usuario?            @relation("UsuarioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  usuariosCreados                                           Usuario[]           @relation("UsuarioCreadoPor")
  modificadoPor                                             Usuario?            @relation("UsuarioModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  usuariosModificados                                       Usuario[]           @relation("UsuarioModificadoPor")
  oficina                                                   Oficina?            @relation(fields: [oficinaId], references: [id])
  rol                                                       Rol                 @relation(fields: [rolId], references: [id])
  valoresCreados                                            ValorCab[]          @relation("ValorCreadoPor")
  valoresModificados                                        ValorCab[]          @relation("ValorModificadoPor")
  vehiculosCreados                                          Vehiculo[]          @relation("VehiculoCreadoPor")
  vehiculosModificados                                      Vehiculo[]          @relation("VehiculoModificadoPor")

  @@index([rolId])
  @@index([oficinaId])
  @@map("usuarios")
}

model Auditoria {
  id            BigInt          @id @default(autoincrement())
  usuarioId     Int?
  tabla         String          @db.VarChar(60)
  accion        AccionAuditoria
  registroId    String?         @db.VarChar(50)
  detalle       Json?
  createdAt     DateTime        @default(now()) @db.Timestamptz(6)
  datosAntes    Json?
  datosDespues  Json?
  ip            String?         @db.VarChar(45)
  modulo        String?         @db.VarChar(100)
  userAgent     String?         @db.VarChar(255)
  usuarioNombre String?         @db.VarChar(50)
  usuario       Usuario?        @relation(fields: [usuarioId], references: [id], onDelete: Restrict)

  @@index([createdAt])
  @@index([usuarioId, createdAt])
  @@index([tabla, registroId])
  @@index([accion, createdAt])
  @@map("auditoria")
}

model Contribuyente {
  id              Int                   @id @default(autoincrement())
  codigoLegacy    String?               @unique @db.VarChar(7)
  tipoPersona     TipoPersona           @default(NATURAL)
  tipoDoc         String                @db.VarChar(10)
  numDoc          String                @unique @db.VarChar(20)
  nombreCompleto  String                @db.VarChar(120)
  direccionFiscal String?               @db.VarChar(150)
  ubigeo          String?               @db.VarChar(6)
  telefono        String?               @db.VarChar(15)
  celular         String?               @db.VarChar(15)
  email           String?               @db.VarChar(100)
  estado          EstadoRegistro        @default(ACTIVO)
  createdAt       DateTime              @default(now())
  updatedAt       DateTime              @updatedAt
  creadoPorId     Int?
  modificadoPorId Int?
  coactivoExps    CoactivoExp[]
  creadoPor       Usuario?              @relation("ContribuyenteCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPor   Usuario?              @relation("ContribuyenteModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  convenios       ConvenioCab[]
  cuentas         CuentaCorriente[]
  declaraciones   DeclaracionJurada[]
  fiscalizaciones fiscalizaciones[]
  licencias       Licencia[]
  pagos           Pago[]                @relation("PagadorContribuyente")
  predios         PredioContribuyente[]
  recibos         recibos[]
  valores         ValorCab[]
  vehiculos       Vehiculo[]

  @@index([nombreCompleto])
  @@index([estado])
  @@map("contribuyentes")
}

model Zona {
  id        Int              @id @default(autoincrement())
  codigo    String           @unique @db.VarChar(5)
  nombre    String           @db.VarChar(100)
  createdAt DateTime         @default(now())
  predios   Predio[]
  tarifas   TarifaArbitrio[]

  @@map("zonas")
}

model Urbanizacion {
  id        Int       @id @default(autoincrement())
  codigo    String    @unique @db.VarChar(10)
  nombre    String    @db.VarChar(100)
  createdAt DateTime  @default(now())
  aranceles Arancel[]
  predios   Predio[]

  @@map("urbanizaciones")
}

model Via {
  id        Int       @id @default(autoincrement())
  tipoVia   String    @db.VarChar(10)
  nombre    String    @db.VarChar(100)
  createdAt DateTime  @default(now())
  aranceles Arancel[]
  predios   Predio[]

  @@unique([tipoVia, nombre])
  @@map("vias")
}

model Predio {
  id                    Int                     @id @default(autoincrement())
  codigoLegacy          String?                 @unique @db.VarChar(7)
  codigoCatastro        String?                 @unique @db.VarChar(20)
  zonaId                Int?
  urbanizacionId        Int?
  viaId                 Int?
  numero                String?                 @db.VarChar(10)
  manzana               String?                 @db.VarChar(10)
  lote                  String?                 @db.VarChar(10)
  referencia            String?                 @db.VarChar(150)
  areaTerreno           Decimal?                @db.Decimal(12, 2)
  areaConstruida        Decimal?                @db.Decimal(12, 2)
  valorAutovaluo        Decimal?                @db.Decimal(14, 2)
  usoPredio             String?                 @db.VarChar(10)
  estado                EstadoRegistro          @default(ACTIVO)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  creadoPorId           Int?
  modificadoPorId       Int?
  cuentas               CuentaCorriente[]
  declaraciones         DeclaracionJurada[]
  fiscalizacion_predios fiscalizacion_predios[]
  licencias             Licencia[]
  otrasInstalaciones    OtraInstalacion[]
  pisos                 Piso[]
  contribuyentes        PredioContribuyente[]
  creadoPor             Usuario?                @relation("PredioCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPor         Usuario?                @relation("PredioModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  urbanizacion          Urbanizacion?           @relation(fields: [urbanizacionId], references: [id], onDelete: Restrict)
  via                   Via?                    @relation(fields: [viaId], references: [id], onDelete: Restrict)
  zona                  Zona?                   @relation(fields: [zonaId], references: [id], onDelete: Restrict)
  valores               ValorCab[]

  @@index([zonaId])
  @@index([urbanizacionId])
  @@index([estado])
  @@map("predios")
}

model PredioContribuyente {
  id               Int            @id @default(autoincrement())
  contribuyenteId  Int
  predioId         Int
  porcentaje       Decimal        @default(100.0) @db.Decimal(6, 2)
  fechaAdquisicion DateTime?      @db.Date
  esPrincipal      Boolean        @default(true)
  estado           EstadoRegistro @default(ACTIVO)
  createdAt        DateTime       @default(now())
  contribuyente    Contribuyente  @relation(fields: [contribuyenteId], references: [id])
  predio           Predio         @relation(fields: [predioId], references: [id])

  @@unique([contribuyenteId, predioId])
  @@index([predioId])
  @@map("predio_contribuyente")
}

model Piso {
  id                 Int               @id @default(autoincrement())
  predioId           Int
  nivel              String            @db.VarChar(10)
  anioConstruccion   Int?
  clasificacion      String?           @db.VarChar(30)
  material           String?           @db.VarChar(20)
  estadoConservacion String?           @db.VarChar(15)
  areaConstruida     Decimal?          @db.Decimal(10, 2)
  valorUnitario      Decimal?          @db.Decimal(10, 2)
  valorConstruccion  Decimal?          @db.Decimal(12, 2)
  createdAt          DateTime          @default(now())
  updatedAt          DateTime          @updatedAt
  categorias         String?           @db.VarChar(7)
  otrasInstalaciones OtraInstalacion[]
  predio             Predio            @relation(fields: [predioId], references: [id], onDelete: Cascade)

  @@index([predioId])
  @@map("pisos")
}

model OtraInstalacion {
  id          Int      @id @default(autoincrement())
  predioId    Int
  pisoId      Int?
  descripcion String   @db.VarChar(150)
  unidad      String?  @db.VarChar(10)
  cantidad    Decimal? @db.Decimal(10, 2)
  valor       Decimal? @db.Decimal(12, 2)
  createdAt   DateTime @default(now())
  piso        Piso?    @relation(fields: [pisoId], references: [id])
  predio      Predio   @relation(fields: [predioId], references: [id], onDelete: Cascade)

  @@index([predioId])
  @@map("otras_instalaciones")
}

model Vehiculo {
  id               Int                    @id @default(autoincrement())
  contribuyenteId  Int
  placa            String                 @unique @db.VarChar(15)
  marca            String                 @db.VarChar(50)
  modelo           String                 @db.VarChar(80)
  anioFabricacion  Int
  numMotor         String?                @db.VarChar(30)
  numTarjeta       String?                @db.VarChar(20)
  valorAdquisicion Decimal?               @db.Decimal(12, 2)
  estado           EstadoRegistro         @default(ACTIVO)
  createdAt        DateTime               @default(now())
  updatedAt        DateTime               @updatedAt
  creadoPorId      Int?
  modificadoPorId  Int?
  cuentas          CuentaCorriente[]
  detalles         VehiculoDetalleAnual[]
  contribuyente    Contribuyente          @relation(fields: [contribuyenteId], references: [id])
  creadoPor        Usuario?               @relation("VehiculoCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPor    Usuario?               @relation("VehiculoModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  @@index([contribuyenteId])
  @@map("vehiculos")
}

model VehiculoDetalleAnual {
  id             Int      @id @default(autoincrement())
  vehiculoId     Int
  anioFiscal     Int
  baseImponible  Decimal  @db.Decimal(12, 2)
  impuesto       Decimal  @db.Decimal(12, 2)
  derechoEmision Decimal  @default(0) @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  vehiculo       Vehiculo @relation(fields: [vehiculoId], references: [id], onDelete: Cascade)

  @@unique([vehiculoId, anioFiscal])
  @@map("vehiculo_detalle_anual")
}

model Tributo {
  id        Int               @id @default(autoincrement())
  codigo    String            @unique @db.VarChar(10)
  nombre    String            @db.VarChar(100)
  tipo      TipoTributo       @default(OTRO)
  activo    Boolean           @default(true)
  createdAt DateTime          @default(now())
  cuentas   CuentaCorriente[]

  @@map("tributos")
}

model Uit {
  id             Int      @id @default(autoincrement())
  anio           Int      @unique
  valor          Decimal  @db.Decimal(10, 2)
  createdAt      DateTime @default(now())
  ordenanza      String?  @db.VarChar(60)
  derechoEmision Decimal  @default(0) @db.Decimal(10, 2)

  @@map("uit")
}

model EscalaPredial {
  id        Int      @id @default(autoincrement())
  anio      Int
  tramo     Int
  desdeUit  Decimal  @db.Decimal(8, 2)
  hastaUit  Decimal? @db.Decimal(8, 2)
  tasa      Decimal  @db.Decimal(6, 4)
  createdAt DateTime @default(now())
  ordenanza String?  @db.VarChar(60)

  @@unique([anio, tramo])
  @@map("escala_predial")
}

model TarifaArbitrio {
  id        Int      @id @default(autoincrement())
  anio      Int
  concepto  String   @db.VarChar(30)
  tasa      Decimal  @db.Decimal(10, 2)
  createdAt DateTime @default(now())
  ordenanza String?  @db.VarChar(60)
  uso       String?  @db.VarChar(10)
  zonaId    Int?
  zona      Zona?    @relation(fields: [zonaId], references: [id], onDelete: Restrict)

  @@index([anio, concepto])
  @@map("tarifas_arbitrios")
}

model Arancel {
  id             Int           @id @default(autoincrement())
  anio           Int
  viaId          Int
  urbanizacionId Int?
  valorM2        Decimal       @db.Decimal(12, 2)
  ordenanza      String?       @db.VarChar(60)
  createdAt      DateTime      @default(now())
  urbanizacion   Urbanizacion? @relation(fields: [urbanizacionId], references: [id], onDelete: Restrict)
  via            Via           @relation(fields: [viaId], references: [id])

  @@index([anio, viaId])
  @@map("aranceles")
}

model ValorUnitario {
  id         Int                    @id @default(autoincrement())
  anio       Int
  componente ComponenteConstruccion
  categoria  String                 @db.VarChar(1)
  valor      Decimal                @db.Decimal(12, 2)
  ordenanza  String?                @db.VarChar(60)
  createdAt  DateTime               @default(now())

  @@unique([anio, componente, categoria])
  @@map("valores_unitarios")
}

model Depreciacion {
  id                 Int      @id @default(autoincrement())
  anio               Int
  clasificacion      String   @db.VarChar(30)
  material           String   @db.VarChar(20)
  antiguedadHasta    Int
  estadoConservacion String   @db.VarChar(15)
  porcentaje         Decimal  @db.Decimal(5, 2)
  ordenanza          String?  @db.VarChar(60)
  createdAt          DateTime @default(now())

  @@unique([anio, clasificacion, material, antiguedadHasta, estadoConservacion])
  @@map("depreciaciones")
}

model TasaMora {
  id            Int          @id @default(autoincrement())
  tipo          TipoTasaMora
  vigenciaDesde DateTime     @db.Date
  valor         Decimal      @db.Decimal(12, 5)
  ordenanza     String?      @db.VarChar(60)
  createdAt     DateTime     @default(now())

  @@unique([tipo, vigenciaDesde])
  @@map("tasas_mora")
}

model DeclaracionJurada {
  id                    Int                     @id @default(autoincrement())
  predioId              Int
  contribuyenteId       Int
  anio                  Int
  motivo                MotivoDeclaracion
  fecha                 DateTime                @db.Date
  snapshot              Json
  observacion           String?                 @db.VarChar(250)
  createdAt             DateTime                @default(now())
  updatedAt             DateTime                @updatedAt
  creadoPorId           Int?
  modificadoPorId       Int?
  fechaHecho            DateTime?               @db.Date
  multaDescartada       String?                 @db.VarChar(200)
  contribuyente         Contribuyente           @relation(fields: [contribuyenteId], references: [id])
  creadoPor             Usuario?                @relation("DeclaracionCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPor         Usuario?                @relation("DeclaracionModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  predio                Predio                  @relation(fields: [predioId], references: [id])
  fiscalizacion_predios fiscalizacion_predios[]
  valores_cab           ValorCab[]

  @@index([predioId, anio])
  @@index([contribuyenteId, anio])
  @@map("declaraciones_juradas")
}

model Tupa {
  id        Int      @id @default(autoincrement())
  codigo    String   @unique @db.VarChar(20)
  glosa     String   @db.VarChar(200)
  tasa      Decimal  @db.Decimal(10, 2)
  activo    Boolean  @default(true)
  createdAt DateTime @default(now())

  @@map("tupa")
}

model CuentaCorriente {
  id                     Int               @id @default(autoincrement())
  contribuyenteId        Int
  predioId               Int?
  vehiculoId             Int?
  tributoId              Int
  anioFiscal             Int
  cuota                  Int               @default(0)
  importe                Decimal           @db.Decimal(12, 2)
  descuento              Decimal           @default(0) @db.Decimal(12, 2)
  reajuste               Decimal           @default(0) @db.Decimal(12, 2)
  mora                   Decimal           @default(0) @db.Decimal(12, 2)
  derechoEmision         Decimal           @default(0) @db.Decimal(12, 2)
  fechaVencimiento       DateTime?         @db.Date
  estado                 EstadoCuenta      @default(PENDIENTE)
  createdAt              DateTime          @default(now())
  updatedAt              DateTime          @updatedAt
  creadoPorId            Int?
  modificadoPorId        Int?
  ajusteDeId             Int?
  coactivoDetalles       CoactivoDet[]
  convenioDetalles       ConvenioDet[]
  convenio_deudas        convenio_deudas[]
  cuenta_corriente       CuentaCorriente?  @relation("cuenta_corrienteTocuenta_corriente", fields: [ajusteDeId], references: [id], onDelete: Restrict)
  other_cuenta_corriente CuentaCorriente[] @relation("cuenta_corrienteTocuenta_corriente")
  contribuyente          Contribuyente     @relation(fields: [contribuyenteId], references: [id])
  creadoPor              Usuario?          @relation("CuentaCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  modificadoPor          Usuario?          @relation("CuentaModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  predio                 Predio?           @relation(fields: [predioId], references: [id], onDelete: Restrict)
  tributo                Tributo           @relation(fields: [tributoId], references: [id])
  vehiculo               Vehiculo?         @relation(fields: [vehiculoId], references: [id], onDelete: Restrict)
  pagos                  Pago[]
  valorDetalles          ValorDet[]

  @@index([contribuyenteId, anioFiscal])
  @@index([predioId, anioFiscal])
  @@index([tributoId, anioFiscal])
  @@index([estado])
  @@index([ajusteDeId])
  @@map("cuenta_corriente")
}

model Pago {
  id                Int             @id @default(autoincrement())
  cuentaCorrienteId Int
  contribuyenteId   Int
  fechaPago         DateTime        @default(now()) @db.Timestamptz(6)
  importe           Decimal         @db.Decimal(12, 2)
  moraPagada        Decimal         @default(0) @db.Decimal(12, 2)
  estado            EstadoCuenta    @default(CANCELADO)
  createdAt         DateTime        @default(now())
  modificadoPorId   Int?
  derechoEmision    Decimal         @default(0) @db.Decimal(12, 2)
  estadoAnterior    EstadoCuenta
  reajuste          Decimal         @default(0) @db.Decimal(12, 2)
  reciboId          Int
  subtotal          Decimal         @db.Decimal(12, 2)
  contribuyente     Contribuyente   @relation("PagadorContribuyente", fields: [contribuyenteId], references: [id])
  cuentaCorriente   CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id])
  modificadoPor     Usuario?        @relation("PagoModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  recibos           recibos         @relation(fields: [reciboId], references: [id])

  @@index([contribuyenteId])
  @@index([fechaPago])
  @@index([cuentaCorrienteId])
  @@index([reciboId])
  @@map("pagos")
}

model ConvenioCab {
  id              Int               @id @default(autoincrement())
  numero          String            @unique @db.VarChar(20)
  contribuyenteId Int
  fecha           DateTime          @default(now()) @db.Date
  montoTotal      Decimal           @db.Decimal(12, 2)
  cuotaInicial    Decimal           @default(0) @db.Decimal(12, 2)
  numCuotas       Int
  estado          EstadoCuenta      @default(FRACCIONADO)
  creadoPorId     Int?
  createdAt       DateTime          @default(now())
  modificadoPorId Int?
  interesMensual  Decimal           @default(0) @db.Decimal(7, 4)
  motivoAnulacion String?           @db.VarChar(200)
  detalles        ConvenioDet[]
  convenio_deudas convenio_deudas[]
  contribuyente   Contribuyente     @relation(fields: [contribuyenteId], references: [id])
  creadoPor       Usuario?          @relation("CreadorConvenio", fields: [creadoPorId], references: [id])
  modificadoPor   Usuario?          @relation("ConvenioModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)

  @@index([contribuyenteId])
  @@map("convenios")
}

model ConvenioDet {
  id                Int             @id @default(autoincrement())
  convenioId        Int
  cuentaCorrienteId Int
  cuotaNumero       Int
  monto             Decimal         @db.Decimal(12, 2)
  fechaVencimiento  DateTime        @db.Date
  estado            EstadoCuenta    @default(PENDIENTE)
  amortizacion      Decimal         @default(0) @db.Decimal(12, 2)
  interes           Decimal         @default(0) @db.Decimal(12, 2)
  convenio          ConvenioCab     @relation(fields: [convenioId], references: [id], onDelete: Cascade)
  cuentaCorriente   CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id])

  @@unique([convenioId, cuotaNumero])
  @@index([cuentaCorrienteId])
  @@map("convenio_detalle")
}

model ValorCab {
  id                      Int                      @id @default(autoincrement())
  tipo                    TipoValor
  anio                    Int
  numero                  String                   @db.VarChar(15)
  contribuyenteId         Int
  predioId                Int?
  totalDeuda              Decimal                  @db.Decimal(12, 2)
  fechaEmision            DateTime                 @default(now()) @db.Date
  fechaNotificacion       DateTime?                @db.Date
  estado                  EstadoValor              @default(EMITIDO)
  createdAt               DateTime                 @default(now())
  creadoPorId             Int?
  modificadoPorId         Int?
  baseImponible           Decimal?                 @db.Decimal(12, 2)
  fechaExigible           DateTime?                @db.Date
  modalidadNotificacion   ModalidadNotificacion?
  motivoAnulacion         String?                  @db.VarChar(200)
  notificadoDni           String?                  @db.VarChar(15)
  notificadoNombre        String?                  @db.VarChar(100)
  transferenciaId         Int?
  declaracionId           Int?
  fiscalizacionId         Int?
  infraccionId            Int?
  expedientes             CoactivoExp[]
  contribuyente           Contribuyente            @relation(fields: [contribuyenteId], references: [id])
  creadoPor               Usuario?                 @relation("ValorCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  declaraciones_juradas   DeclaracionJurada?       @relation(fields: [declaracionId], references: [id], onDelete: Restrict)
  fiscalizaciones         fiscalizaciones?         @relation(fields: [fiscalizacionId], references: [id], onDelete: Restrict)
  infracciones            infracciones?            @relation(fields: [infraccionId], references: [id], onDelete: Restrict)
  modificadoPor           Usuario?                 @relation("ValorModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  predio                  Predio?                  @relation(fields: [predioId], references: [id], onDelete: Restrict)
  transferencias_coactivo transferencias_coactivo? @relation(fields: [transferenciaId], references: [id], onDelete: Restrict)
  detalles                ValorDet[]

  memorandumId           Int?
  auxiliarAsignadoId     Int?

  memorandumCoactiva     memorandums_coactiva? @relation(fields: [memorandumId], references: [id], onDelete: SetNull)
  auxiliarAsignado       auxiliares_coactivo?  @relation("ValorAuxiliarAsignado", fields: [auxiliarAsignadoId], references: [id], onDelete: SetNull)

  @@unique([tipo, anio, numero])
  @@index([contribuyenteId])
  @@index([estado])
  @@index([fiscalizacionId])
  @@index([memorandumId])
  @@index([auxiliarAsignadoId])
  @@map("valores_cab")
}

model ValorDet {
  id                Int             @id @default(autoincrement())
  valorId           Int
  cuentaCorrienteId Int
  importe           Decimal         @db.Decimal(12, 2)
  mora              Decimal         @default(0) @db.Decimal(12, 2)
  reajuste          Decimal         @default(0) @db.Decimal(12, 2)
  subtotal          Decimal         @db.Decimal(12, 2)
  cuentaCorriente   CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id])
  valor             ValorCab        @relation(fields: [valorId], references: [id], onDelete: Cascade)

  @@index([cuentaCorrienteId])
  @@map("valores_det")
}

model CoactivoExp {
  id                  Int                  @id @default(autoincrement())
  anioExpediente      Int
  numExpediente       String               @db.VarChar(15)
  valorId             Int?
  contribuyenteId     Int
  estado              EstadoValor          @default(EMITIDO)
  fechaGeneracion     DateTime             @default(now()) @db.Date
  createdAt           DateTime             @default(now())
  creadoPorId         Int?
  modificadoPorId     Int?
  auxiliarId          Int?
  ejecutorId          Int?
  tipoGestionId       Int?
  detalles            CoactivoDet[]
  auxiliares_coactivo auxiliares_coactivo? @relation(fields: [auxiliarId], references: [id])
  contribuyente       Contribuyente        @relation(fields: [contribuyenteId], references: [id])
  creadoPor           Usuario?             @relation("ExpedienteCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  ejecutores_coactivo ejecutores_coactivo? @relation(fields: [ejecutorId], references: [id])
  modificadoPor       Usuario?             @relation("ExpedienteModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  valor               ValorCab?            @relation(fields: [valorId], references: [id])

  @@unique([anioExpediente, numExpediente])
  @@index([contribuyenteId])
  @@index([auxiliarId])
  @@index([ejecutorId])
  @@map("coactivo_exp")
}

model CoactivoDet {
  id                Int              @id @default(autoincrement())
  expedienteId      Int
  cuentaCorrienteId Int?
  descripcion       String           @db.VarChar(150)
  monto             Decimal          @db.Decimal(12, 2)
  cuentaCorriente   CuentaCorriente? @relation(fields: [cuentaCorrienteId], references: [id], onDelete: Restrict)
  expediente        CoactivoExp      @relation(fields: [expedienteId], references: [id], onDelete: Cascade)

  @@index([expedienteId])
  @@map("coactivo_det")
}

model GiroNegocio {
  id          Int        @id @default(autoincrement())
  codigo      String     @unique @db.VarChar(10)
  descripcion String     @db.VarChar(150)
  activo      Boolean    @default(true)
  licencias   Licencia[]

  @@map("giros_negocio")
}

model Licencia {
  id               Int            @id @default(autoincrement())
  numeroLicencia   String         @unique @db.VarChar(20)
  contribuyenteId  Int
  predioId         Int?
  giroId           Int?
  direccionLocal   String?        @db.VarChar(150)
  area             Decimal?       @db.Decimal(10, 2)
  horario          String?        @db.VarChar(100)
  fechaEmision     DateTime       @default(now()) @db.Date
  fechaVencimiento DateTime?      @db.Date
  estado           EstadoLicencia @default(VIGENTE)
  createdAt        DateTime       @default(now())
  updatedAt        DateTime       @updatedAt
  creadoPorId      Int?
  modificadoPorId  Int?
  contribuyente    Contribuyente  @relation(fields: [contribuyenteId], references: [id])
  creadoPor        Usuario?       @relation("LicenciaCreadoPor", fields: [creadoPorId], references: [id], onDelete: Restrict)
  giro             GiroNegocio?   @relation(fields: [giroId], references: [id], onDelete: Restrict)
  modificadoPor    Usuario?       @relation("LicenciaModificadoPor", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  predio           Predio?        @relation(fields: [predioId], references: [id], onDelete: Restrict)

  @@index([contribuyenteId])
  @@index([estado])
  @@map("licencias")
}

model auxiliares_coactivo {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique @db.VarChar(10)
  nombre       String        @db.VarChar(100)
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())

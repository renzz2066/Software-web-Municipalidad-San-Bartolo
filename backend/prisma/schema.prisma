  porcentajeJuridica Decimal    @db.Decimal(7, 2)
  ordenanza          String?    @db.VarChar(60)
  createdAt          DateTime   @default(now())
  valores_cab        ValorCab[]

  @@unique([anio, codigo])
}

model parametros_fraccionamiento {
  id                 Int      @id @default(autoincrement())
  anio               Int      @unique
  cuotaInicialMinPct Decimal  @db.Decimal(5, 2)
  cuotasMax          Int

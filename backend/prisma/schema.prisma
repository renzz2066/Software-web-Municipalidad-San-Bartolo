  fiscalizaciones       fiscalizaciones    @relation(fields: [fiscalizacionId], references: [id])
  predios               Predio             @relation(fields: [predioId], references: [id])

  @@unique([fiscalizacionId, predioId])
  @@index([predioId])
}

model fiscalizaciones {
  id                                                 Int                     @id @default(autoincrement())
  anio                                               Int
  numero                                             String                  @db.VarChar(15)
  tipo                                               TipoFiscalizacion
  contribuyenteId                                    Int
  fiscalizadorId                                     Int
  anioDesde                                          Int
  anioHasta                                          Int
  estado                                             EstadoFiscalizacion     @default(ABIERTO)
  fechaInspeccion                                    DateTime?               @db.Timestamptz(6)
  fechaNotificacion                                  DateTime?               @db.Date
  modalidadNotificacion                              ModalidadNotificacion?
  notificadoDni                                      String?                 @db.VarChar(15)
  notificadoNombre                                   String?                 @db.VarChar(100)
  observacion                                        String?                 @db.VarChar(500)
  motivoAnulacion                                    String?                 @db.VarChar(200)
  createdAt                                          DateTime                @default(now())
  updatedAt                                          DateTime
  creadoPorId                                        Int?
  modificadoPorId                                    Int?
  fiscalizacion_predios                              fiscalizacion_predios[]
  contribuyentes                                     Contribuyente           @relation(fields: [contribuyenteId], references: [id])
  usuarios_fiscalizaciones_creadoPorIdTousuarios     Usuario?                @relation("fiscalizaciones_creadoPorIdTousuarios", fields: [creadoPorId], references: [id], onDelete: Restrict)
  fiscalizadores                                     fiscalizadores          @relation(fields: [fiscalizadorId], references: [id])
  usuarios_fiscalizaciones_modificadoPorIdTousuarios Usuario?                @relation("fiscalizaciones_modificadoPorIdTousuarios", fields: [modificadoPorId], references: [id], onDelete: Restrict)
  valores_cab                                        ValorCab[]

  @@unique([anio, numero])
  @@index([contribuyenteId])
  @@index([estado])
}

model fiscalizadores {
  id              Int               @id @default(autoincrement())
  nombre          String            @db.VarChar(100)
  dni             String            @unique @db.VarChar(15)
  activo          Boolean           @default(true)
  usuarioId       Int?              @unique
  createdAt       DateTime          @default(now())
  fiscalizaciones fiscalizaciones[]
  usuarios        Usuario?          @relation(fields: [usuarioId], references: [id], onDelete: Restrict)
}

model infracciones {
  id                 Int        @id @default(autoincrement())

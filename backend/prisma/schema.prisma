model convenio_deudas {
  id                Int             @id @default(autoincrement())
  convenioId        Int
  cuentaCorrienteId Int
  insoluto          Decimal         @db.Decimal(12, 2)
  reajuste          Decimal         @default(0) @db.Decimal(12, 2)
  mora              Decimal         @default(0) @db.Decimal(12, 2)
  subtotal          Decimal         @db.Decimal(12, 2)
  convenios         ConvenioCab     @relation(fields: [convenioId], references: [id])
  cuenta_corriente  CuentaCorriente @relation(fields: [cuentaCorrienteId], references: [id])

  @@unique([convenioId, cuentaCorrienteId])
  @@index([cuentaCorrienteId])
}

model correlativos {
  serie  String @db.VarChar(10)
  anio   Int
  ultimo Int    @default(0)

  @@id([serie, anio])
}

model ejecutores_coactivo {
  id           Int           @id @default(autoincrement())
  codigo       String        @unique @db.VarChar(10)
  nombre       String        @db.VarChar(100)
  activo       Boolean       @default(true)
  createdAt    DateTime      @default(now())

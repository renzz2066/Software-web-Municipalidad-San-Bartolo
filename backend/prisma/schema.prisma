  createdAt          DateTime @default(now())
}

model recibos {
  id                                        Int           @id @default(autoincrement())
  anio                                      Int
  numero                                    String        @db.VarChar(15)
  contribuyenteId                           Int
  cajeroId                                  Int
  fecha                                     DateTime      @default(now()) @db.Timestamptz(6)
  fechaCaja                                 DateTime      @db.Date
  total                                     Decimal       @db.Decimal(12, 2)
  medioPago                                 MedioPago     @default(EFECTIVO)
  numOperacion                              String?       @db.VarChar(30)
  estado                                    EstadoCuenta  @default(CANCELADO)
  motivoExtorno                             String?       @db.VarChar(200)
  extornadoPorId                            Int?
  fechaExtorno                              DateTime?     @db.Timestamptz(6)
  fechaCajaExtorno                          DateTime?     @db.Date
  cierreId                                  Int?
  createdAt                                 DateTime      @default(now())
  pagos                                     Pago[]
  usuarios_recibos_cajeroIdTousuarios       Usuario       @relation("recibos_cajeroIdTousuarios", fields: [cajeroId], references: [id])
  cierres_caja                              cierres_caja? @relation(fields: [cierreId], references: [id], onDelete: Restrict)
  contribuyentes                            Contribuyente @relation(fields: [contribuyenteId], references: [id])
  usuarios_recibos_extornadoPorIdTousuarios Usuario?      @relation("recibos_extornadoPorIdTousuarios", fields: [extornadoPorId], references: [id], onDelete: Restrict)

  @@unique([anio, numero])
  @@index([cajeroId, fechaCaja])
  @@index([contribuyenteId])
  @@index([extornadoPorId, fechaCajaExtorno])
  @@index([fechaCaja])
}

model tipos_gestion_coactiva {
  id          Int       @id @default(autoincrement())
  codigo      String    @unique @db.VarChar(10)
  descripcion String    @db.VarChar(150)
  activo      Boolean?  @default(true)
  createdAt   DateTime? @default(now())
}

model transferencias_coactivo {
  id          Int                 @id @default(autoincrement())
  anio        Int
  numero      String              @db.VarChar(15)
  fecha       DateTime            @default(now()) @db.Date
  cantidad    Int
  monto       Decimal             @db.Decimal(12, 2)
  estado      EstadoTransferencia @default(ENVIADA)
  createdAt   DateTime            @default(now())
  valores_cab ValorCab[]

  @@unique([anio, numero])
}


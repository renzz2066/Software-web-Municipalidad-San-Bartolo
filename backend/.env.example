# Postgres + Supabase (pooler 6543 para la app, directa 5432 para migraciones)
# Consigue ambas en: Supabase Dashboard -> Project Settings -> Database -> Connection string
DATABASE_URL="postgresql://postgres:[password]@db.[ref].supabase.co:6543/postgres?pgbouncer=true&connection_limit=1"
DIRECT_URL="postgresql://postgres:[password]@db.[ref].supabase.co:5432/postgres"

JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

PORT=3000
FRONTEND_URL="http://localhost:5173"

# IA — Chat San Bartolo (specs/ia-chat-v1.md). Key en https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_MODEL_RESPALDO="gemini-flash-lite-latest"
# Opcionales: GEMINI_EMBED_MODEL="gemini-embedding-001", GEMINI_TIMEOUT_MS=30000, IA_TOP_K=5, IA_SIMILITUD_MIN=0.6

# Identidad para autocompletar el formulario de contribuyentes (specs/consulta-identidad-v1.md).
# Token gratis en https://apiperu.dev -> Api Tokens. Sin clave, el botón "Buscar datos" avisa y se sigue a mano.
IDENTIDAD_API_BASE="https://api.apiperu.dev"
IDENTIDAD_API_KEY=""
IDENTIDAD_TIMEOUT_MS=6000

# Laboratorio local (infra/docker-compose.yml): Postgres 16 + pgvector en :5433, sin pgbouncer.
# Copia a .env.local-lab. DATABASE_URL/DIRECT_URL solo los usa Prisma CLI; el backend usa DATABASE_URL__<SLUG>.
DATABASE_URL="postgresql://postgres:postgres@localhost:5433/muni_san_bartolo"
DIRECT_URL="postgresql://postgres:postgres@localhost:5433/muni_san_bartolo"
# Multi-muni (specs/multi-muni-v1.md): munis activas, la de por defecto y la base de cada una.
MUNIS="sanbartolo,demo"
MUNI_DEFAULT="sanbartolo"
DATABASE_URL__SANBARTOLO="postgresql://postgres:postgres@localhost:5433/muni_san_bartolo"
DATABASE_URL__DEMO="postgresql://postgres:postgres@localhost:5433/muni_demo"

JWT_SECRET="cambia-este-valor-por-un-secreto-largo-y-aleatorio"
JWT_EXPIRES_IN="8h"

PORT=3000
FRONTEND_URL="http://localhost:5173"

# IA — Chat San Bartolo (specs/ia-chat-v1.md). Key en https://aistudio.google.com/apikey
GEMINI_API_KEY=""
GEMINI_MODEL="gemini-flash-lite-latest"
GEMINI_MODEL_RESPALDO="gemini-flash-lite-latest"
# Opcionales: GEMINI_EMBED_MODEL="gemini-embedding-001", GEMINI_TIMEOUT_MS=30000, IA_TOP_K=5, IA_SIMILITUD_MIN=0.6

# Identidad para autocompletar el formulario de contribuyentes (specs/consulta-identidad-v1.md).
# Token gratis en https://apiperu.dev -> Api Tokens. Sin clave, el botón "Buscar datos" avisa y se sigue a mano.
IDENTIDAD_API_BASE="https://api.apiperu.dev"
IDENTIDAD_API_KEY=""
IDENTIDAD_TIMEOUT_MS=6000
